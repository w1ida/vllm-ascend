        SetFlag<HardEvent::M_MTE1>(EVENT_ID2);
    }

    [aicore] inline void EnQue()
    {
        SetFlag<HardEvent::MTE1_M>(EVENT_ID2);
    }

    [aicore] inline void DeQue()
    {
        WaitFlag<HardEvent::MTE1_M>(EVENT_ID2);
    }

private:
    TBuf<TPosition::C2> biasBuf_;
};

