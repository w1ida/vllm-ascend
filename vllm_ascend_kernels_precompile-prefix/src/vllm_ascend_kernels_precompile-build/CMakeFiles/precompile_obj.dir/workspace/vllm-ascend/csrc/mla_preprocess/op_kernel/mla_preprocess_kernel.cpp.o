public:
    [aicore] inline BatchSchedulerBase() = default;
    [aicore] inline ~BatchSchedulerBase() = default;

    [aicore] inline void Init(const TCubeTiling *__restrict cubeTiling, TPipe *tpipe)
    {
        cast_to_MatmulShapeTiling()->SetTiling(cubeTiling);
        cast_to_MatmulShapeTiling()->template CheckTiling<SrcT, L0cT>();
        auto& var = static_cast<IMPL*>(this)->var;
        var.tpipe_ = tpipe;





        auto shapeInfo = cast_to_MatmulShapeInfo();
        shapeInfo->InitParams();

        cast_to_MLoop()->Init(shapeInfo->GetSingleCoreM());
        cast_to_NLoop()->Init(shapeInfo->GetSingleCoreN());
        cast_to_KLoop()->Init(shapeInfo->GetSingleCoreK());
        cast_to_BatchLoop()->Init();
        cast_to_TBufPoolL0()->Init();

        const auto& tiling = cast_to_MatmulShapeTiling()->GetTiling();
        uint32_t shareUbSize = static_cast<uint32_t>(tiling.GetShareUbSize());

        uint32_t shareLens[SHARE_LEN_SIZE] = {static_cast<uint32_t>(tiling.GetShareL1Size()),
            static_cast<uint32_t>(tiling.GetShareL0CSize()), shareUbSize};
        InitShareBufStart(var.tpipe_, tiling.GetShareMode(), shareLens, SHARE_LEN_SIZE,
            cast_to_MatmulSubBlockInfo()->GetSubBlockIdx());

        cast_to_BatchCopyCubeInA()->Init();
        cast_to_BatchCopyCubeInB()->Init();
        uint32_t lenFactor = 1;
        if constexpr (!MatmulFeatureTrait<MM_CFG>::IsNeedUB() && ToMatmulConfig(MM_CFG).scheduleType == ScheduleType::OUTER_PRODUCT) {
            lenFactor = DOUBLE_SIZE;
        }

        if constexpr (ToMatmulConfig(MM_CFG).bmmOutMode != BatchOutMode::SINGLE_BATCH) {
            cast_to_CubeOutBuffer()->Init(tiling.GetBaseM() * tiling.GetBaseN() * nBatchOutNum_, lenFactor);
        } else {
            cast_to_CubeOutBuffer()->Init(tiling.GetBaseM() * tiling.GetBaseN(), lenFactor);
        }
        if constexpr (ToMatmulConfig(MM_CFG).batchMode == BatchMode::BATCH_LARGE_THAN_L1) {
            cast_to_BiasScheduler()->Init(cast_to_BatchLoop()->GetBatchNum());
        } else if constexpr (ToMatmulConfig(MM_CFG).batchMode == BatchMode::BATCH_LESS_THAN_L1) {
            cast_to_BiasScheduler()->Init(tiling.GetBatchNum());
        }
# 117 "/usr/local/Ascend/cann-8.5.0/aarch64-linux/tikcpp/tikcfw/include/adv_api/matmul/../../../impl/adv_api/detail/matmul/policy/../scheduler/batch/batch_scheduler_base.h"
        InitShareBufEnd(var.tpipe_);
    }

    [aicore] inline BatchSchedulerContext PrepareContext()
    {
        BatchSchedulerContext ctx;
        InitL0Params(ctx);
        CalcReduceGInfo(ctx);
        return ctx;
    }


    [aicore] inline void CalcBatchIterateAOffsetInfo(BatchOffsetInfo& batchOffsetInfo)
    {
        const auto tiling = cast_to_MatmulShapeTiling()->GetTiling();
        if constexpr (A_TYPE::layout == LayoutMode::NORMAL) {
            batchOffsetInfo.modA = 1;
            batchOffsetInfo.divisorA = cast_to_BatchLoop()->GetBatchNum() / cast_to_BatchLoop()->GetBatchA();
        } else {
            if (tiling.GetALayoutInfoG() == 1 && tiling.GetBLayoutInfoG() != 1) {

                                                                           ;
                batchOffsetInfo.modA = 1;
                batchOffsetInfo.divisorA = tiling.GetBLayoutInfoG();
            } else if (tiling.GetALayoutInfoN() == 1 && tiling.GetBLayoutInfoN() != 1) {


                                                                           ;
                batchOffsetInfo.modA = tiling.GetBLayoutInfoG();
                batchOffsetInfo.divisorA = tiling.GetBLayoutInfoG() * tiling.GetBLayoutInfoN();
            } else if (tiling.GetALayoutInfoB() == 1 && tiling.GetBLayoutInfoB() != 1) {
                                                                                                                ;
                batchOffsetInfo.modA = tiling.GetBLayoutInfoG() * tiling.GetBLayoutInfoN();
                batchOffsetInfo.divisorA = tiling.GetBLayoutInfoG() * tiling.GetBLayoutInfoN() * tiling.GetBLayoutInfoB();
            } else {
                batchOffsetInfo.modA = 1;
                batchOffsetInfo.divisorA = 1;
            }
        }

        const auto matmulShapeInfo = cast_to_MatmulShapeInfo();
        if (cast_to_MatmulShapeInfo()->IsTransposeA()) {
            int32_t alignMa = CeilAlign(matmulShapeInfo->template GetSingleCoreM<false, IsBasic(MM_CFG)>(), c0Size_);
            constexpr int32_t alignSize = IsSameTypeV<SrcT, int8_t> ? c0Size_ : BLOCK_CUBE;
            int32_t alignKa = CeilAlign(matmulShapeInfo->template GetSingleCoreK<false, IsBasic(MM_CFG)>(), alignSize);
            batchOffsetInfo.alignA = alignMa * alignKa;
        } else {
            int32_t alignMa = CeilAlign(matmulShapeInfo->template GetSingleCoreM<false, IsBasic(MM_CFG)>(), BLOCK_CUBE);
            int32_t alignKa = CeilAlign(matmulShapeInfo->template GetSingleCoreK<false, IsBasic(MM_CFG)>(), c0Size_);
            batchOffsetInfo.alignA = alignMa * alignKa;
        }
    }

    [aicore] inline void CalcBatchIterateBOffsetInfo(BatchOffsetInfo& batchOffsetInfo)
    {
        const auto tiling = cast_to_MatmulShapeTiling()->GetTiling();
        if constexpr (B_TYPE::layout == LayoutMode::NORMAL) {
            batchOffsetInfo.modB = 1;
            batchOffsetInfo.divisorB = cast_to_BatchLoop()->GetBatchNum() / cast_to_BatchLoop()->GetBatchB();
        } else {
            if (tiling.GetBLayoutInfoG() == 1 && tiling.GetALayoutInfoG() != 1) {

                                                                           ;
                batchOffsetInfo.modB = 1;
                batchOffsetInfo.divisorB = tiling.GetALayoutInfoG();
            } else if (tiling.GetBLayoutInfoN() == 1 && tiling.GetALayoutInfoN() != 1) {


                                                                           ;
                batchOffsetInfo.modB = tiling.GetALayoutInfoG();
                batchOffsetInfo.divisorB = tiling.GetALayoutInfoG() * tiling.GetALayoutInfoN();
            } else if (tiling.GetBLayoutInfoB() == 1 && tiling.GetALayoutInfoB() != 1) {

                                                                           ;
                batchOffsetInfo.modB = tiling.GetALayoutInfoG() * tiling.GetALayoutInfoN();
                batchOffsetInfo.divisorB = tiling.GetALayoutInfoG() * tiling.GetALayoutInfoN() * tiling.GetALayoutInfoB();
            } else {
                batchOffsetInfo.modB = 1;
                batchOffsetInfo.divisorB = 1;
            }
        }

        const auto matmulShapeInfo = cast_to_MatmulShapeInfo();
        if (cast_to_MatmulShapeInfo()->IsTransposeB()) {
            int32_t alignNb = CeilAlign(matmulShapeInfo->template GetSingleCoreN<false, IsBasic(MM_CFG)>(), BLOCK_CUBE);
            int32_t alignKb = CeilAlign(matmulShapeInfo->template GetSingleCoreK<false, IsBasic(MM_CFG)>(), c0Size_);
            batchOffsetInfo.alignB = alignNb * alignKb;
        } else {
            constexpr int32_t alignSize = IsSameTypeV<SrcT, int8_t> ? c0Size_ : BLOCK_CUBE;
            int32_t alignNb = CeilAlign(matmulShapeInfo->template GetSingleCoreN<false, IsBasic(MM_CFG)>(), c0Size_);
            int32_t alignKb = CeilAlign(matmulShapeInfo->template GetSingleCoreK<false, IsBasic(MM_CFG)>(), alignSize);
            batchOffsetInfo.alignB = alignNb * alignKb;
        }
    }

    [aicore] inline bool MoveNext()
    {
        if (__builtin_expect(!!(isFirstIter_), 0)) {
            return MoveOnFirstIterate();
        } else {
            if constexpr (ToMatmulConfig(MM_CFG).bmmOutMode == BatchOutMode::MULTI_BATCH) {
                return false;
            }
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                if (__builtin_expect(!!(cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() == static_cast<int>(IterateOrder::ORDER_M)), 1)) {
                    return MoveOnIterateOrderM();
                } else {


                                                                                           ;
                    return MoveOnIterateOrderN();
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_N) {
                return MoveOnIterateOrderN();
            } else {
                return MoveOnIterateOrderM();
            }
        }
        return true;
    }


    [aicore] inline void InitSplitAParams(SplitParams& aL0Params)
    {
        aL0Params.axisL0Len = IsStaticPaddingEnable(MM_CFG) ?
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() : cast_to_MLoop()->GetBaseShape();
        if constexpr ((A_TYPE::format == CubeFormat::VECTOR) || (A_TYPE::format == CubeFormat::SCALAR)) {
            aL0Params.axisL0Len = 1;
        } else if (!MatmulFeatureTrait<MM_CFG>::IsSupportDisableGemvMode() && aL0Params.axisL0Len == 1) {
            aL0Params.axisL0Len = BLOCK_CUBE;
        }

        aL0Params.kAxisL1Offset = 0;
        aL0Params.axisL1Offset = IsBasic(MM_CFG) ? 0 :
            cast_to_MLoop()->GetOuterIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseM();
    }

    [aicore] inline void InitSplitBParams(SplitParams& bL0Params)
    {
        bL0Params.axisL0Len = IsStaticPaddingEnable(MM_CFG) ?
            cast_to_MatmulShapeTiling()->GetTiling().GetBaseN() : cast_to_NLoop()->GetBaseShape();

        bL0Params.kAxisL1Offset = 0;
        bL0Params.axisL1Offset = IsBasic(MM_CFG) ? 0 :
            cast_to_NLoop()->GetOuterIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
    }

    [aicore] inline void UpdateSplitParams(SplitParams& aL0Params, SplitParams& bL0Params)
    {
        if constexpr (!IsBasic(MM_CFG)) {
            aL0Params.kAxisL1Offset = cast_to_KLoop()->GetOuterIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
            bL0Params.kAxisL1Offset = aL0Params.kAxisL1Offset;
        }
    }

    [aicore] inline void UpdateSplitParams(bool enPartialSum, SplitParams& aL0Params, SplitParams& bL0Params,
        int32_t& sL0CInit, int32_t& sL0CLast)
    {
        if constexpr (!IsBasic(MM_CFG)) {
            aL0Params.kAxisL1Offset = cast_to_KLoop()->GetOuterIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
            bL0Params.kAxisL1Offset = aL0Params.kAxisL1Offset;
        }

        if (__builtin_expect(!!(cast_to_KLoop()->GetOuterIdx() == 0), 0)) {
            sL0CInit = enPartialSum ? 0 : 1;
        } else {
            sL0CInit = 0;
        }
        if constexpr (EnUnitFlag(MM_CFG)) {
            sL0CLast = (cast_to_KLoop()->GetOuterIdx() == cast_to_KLoop()->GetTotalIter() - 1 ) ? 1 : 0;
        } else {
            sL0CLast = 0;
        }
    }


    [aicore] inline void MacroCompute(LocalTensor<TransAT>& a1, LocalTensor<TransBT>& b1,
        BatchSchedulerContext& ctx, int32_t sL0CInit, int32_t sL0CLast)
    {

        bool isATranspose = cast_to_MatmulShapeInfo()->IsTransposeA();
        bool isBTranspose = cast_to_MatmulShapeInfo()->IsTransposeB();
        cast_to_LoadToA2()->Prepare(isATranspose, ctx.aL0Params.kAxisL1Len, ctx.aL0Params.axisL1Len);
        cast_to_LoadToB2()->Prepare(isBTranspose, ctx.bL0Params.kAxisL1Len);
        int32_t kL0Len = cast_to_KLoop()->GetTileShapeA();

        auto& bufferPool = cast_to_TBufPoolL0()->Allocate();
        LocalTensor<TransAT> a2 = bufferPool.template GetBuffer<TPosition::A2, TransAT>();
        LocalTensor<TransBT> b2 = bufferPool.template GetBuffer<TPosition::B2, TransBT>();

        cast_to_LoadToA2()->Load(a2, a1[ctx.offsetA], ctx.aL0Params.axisL1Len, ctx.aL0Params.kAxisL1Len,
            ctx.aL0Params.axisL0Len, kL0Len, ctx.aL0Params.axisL1Offset, ctx.aL0Params.kAxisL1Offset, isATranspose);
        cast_to_LoadToB2()->Load(b2, b1[ctx.offsetB], ctx.bL0Params.axisL1Len, ctx.bL0Params.kAxisL1Len,
            ctx.bL0Params.axisL0Len, kL0Len, ctx.bL0Params.axisL1Offset, ctx.bL0Params.kAxisL1Offset, isBTranspose);
        bufferPool.EnQue();
        bufferPool.DeQue();


        bool cmatrixSource;
        bool cmatrixInitVal;
        UpdateMmadComputeParams(sL0CInit, cmatrixSource, cmatrixInitVal);
        int32_t offsetC = 0;
        if constexpr (ToMatmulConfig(MM_CFG).bmmOutMode != BatchOutMode::SINGLE_BATCH) {
            offsetC = cast_to_MatmulShapeTiling()->GetTiling().GetBaseM() *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseN() *
                (cast_to_BatchLoop()->GetBatchOutCacheNum() - 1);
        }
        cast_to_MmadCompute()->Compute(cast_to_CubeOutBuffer()->GetTensor()[offsetC], a2, b2,
            ctx.aL0Params.axisL0Len, kL0Len, ctx.bL0Params.axisL0Len, isATranspose, isBTranspose,
            cast_to_MatmulUnitFlag()->GetUnitFlag(sL0CLast), cmatrixSource, cmatrixInitVal, false);
        bufferPool.Free();
        cast_to_BiasScheduler()->Free();
    }

    [aicore] inline void UpdateMmadComputeParams(bool sL0CInit, bool& cmatrixSource, bool& cmatrixInitVal)
    {
        if constexpr (MatmulFeatureTrait<MM_CFG>::IsNeedUB()) {
            cmatrixSource = false;
        } else {
            cmatrixSource = sL0CInit && cast_to_BiasScheduler()->IsBias();
        }
        cmatrixInitVal = sL0CInit && !cast_to_BiasScheduler()->IsBias();
    }


    template<class T>
    [aicore] inline void GetBatchResult(const T &dst, const BatchSchedulerContext& ctx,
        uint8_t enAtomic, bool enSequentialWriteIn)
    {

        if constexpr (A_TYPE::layout != LayoutMode::NORMAL) {
            if (ctx.isReduceG) {
                SetAtomicAdd<DstT>();
            }
        }

        int32_t stride = 0;
        const auto tiling = cast_to_MatmulShapeTiling()->GetTiling();
        if constexpr (C_TYPE::layout == LayoutMode::BNGS1S2 || C_TYPE::layout == LayoutMode::NORMAL) {

            int32_t alignedSingleCoreN = CeilAlign(tiling.GetSingleCoreN(), AscendCUtils::GetC0Count(sizeof(DstT)));
            if constexpr (PhyPosIsGM(C_TYPE::pos)) {
                alignedSingleCoreN = tiling.GetSingleCoreN();
            }
