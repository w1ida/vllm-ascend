    }

    [aicore] inline LocalTensor<L0cT> Allocate()
    {
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID2);
        LocalTensor<L0cT> biasC2 = biasBuf_.Get<L0cT>();
        return biasC2;
