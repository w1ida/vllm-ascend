        src1Pattern.SetSize(PATTERN_SIZE);
        src1Pattern.SetValue(0, 0xFFFF << remainLen);
        src1Pattern.SetValue(1, (1 << remainLen) - 1);
        for (int32_t i = PATTERN_OFFSET; i < PATTERN_SIZE; ++i) {
            src1Pattern.SetValue(i, 0);
