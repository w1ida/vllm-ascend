}


template <typename U>
[aicore] inline void RemoveRedundantMask(const LocalTensor<U> &dst, const LocalTensor<U> &mask,
    const LocalTensor<uint8_t> &sharedTmpBuffer, const SelectWithBytesMaskShapeInfo &info)
