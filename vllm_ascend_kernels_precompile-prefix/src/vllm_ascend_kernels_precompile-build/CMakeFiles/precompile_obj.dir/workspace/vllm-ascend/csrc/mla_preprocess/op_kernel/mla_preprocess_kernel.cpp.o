        DataCopyUB2L1Impl(reinterpret_cast<__attribute__((cce_cube_buff)) T*>(g_tpipeImpl.spmInfo_.spmAddr) + writeOffset,
            reinterpret_cast<__attribute__((cce_unif_buff)) T*>(write.GetPhyAddr()), repeatParams);
