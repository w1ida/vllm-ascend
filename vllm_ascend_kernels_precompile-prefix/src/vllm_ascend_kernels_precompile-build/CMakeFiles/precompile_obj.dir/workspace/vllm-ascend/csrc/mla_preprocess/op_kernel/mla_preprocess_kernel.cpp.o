    [aicore] inline void End() {
        if constexpr (!NormInitScene<MM_CFG> && !MdlInitScene<MM_CFG> && !DoMatmulIBShareNorm(MM_CFG)) {
                                                                                                 ;
            return;
        }
        cast_to_CopyCubeInA()->Destroy();
        cast_to_CopyCubeInB()->Destroy();
        cast_to_BiasScheduler()->End();
        cast_to_TBufPoolL0()->ResetCache();
        cast_to_CubeOutBuffer()->Destroy();
        cast_to_MatmulQuantProcessor()->Destroy();
        if constexpr (MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape()) {
            cast_to_MatmulCrossCoreSync()->End();
        }
        if constexpr (__builtin_expect(!!(Impl::Detail::MatmulFeatureTrait<MM_CFG>::IsUnitFlagEnabled()), 0) &&
            C_TYPE::format == CubeFormat::ND) {
                SetMMLayoutTransform(0);
        }
    }

    [aicore] inline int64_t GetL0cOffset()
    {
        auto baseHeight = cast_to_MLoop()->GetBaseShape();
        auto baseWidth = cast_to_NLoop()->GetBaseShape();
        baseWidth = CeilAlign(baseWidth, BLOCK_CUBE);
        baseHeight = CeilAlign(baseHeight, BLOCK_CUBE);
        return baseHeight * baseWidth;
    }

