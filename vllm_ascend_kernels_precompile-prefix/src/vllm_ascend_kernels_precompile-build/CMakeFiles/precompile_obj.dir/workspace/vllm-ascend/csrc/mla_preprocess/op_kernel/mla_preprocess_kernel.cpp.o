[aicore] inline void AscendAntiQuantImpl(const LocalTensor<DstType> &dst, const LocalTensor<SrcType> &src,
    const DstType offset, const DstType scale, const uint32_t K, const AntiQuantShapeInfo& shapeInfo = {})
