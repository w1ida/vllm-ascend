    using TransAT = typename A_TYPE::T;
    using TransBT = typename decltype(GetTransBDataType<A_TYPE, B_TYPE, MM_CFG>())::T;
    using L0cT = typename GetMmDstType<typename A_TYPE::T>::Type;

public:
    using BASE_MODULE = AscendC::Impl::Detail::MatmulSchedulerBase<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, POLICY_TYPE>;
    [aicore] inline void Init(const TCubeTiling *__restrict cubeTiling, TPipe *tpipe)
    {
        BASE_MODULE::Init(cubeTiling, tpipe);
        if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload > 0) {
            if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_M) {
                                                                                                                         ;
            } else if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_N) {
                                                                                                                         ;
            }
            const auto& tiling = cast_to_MatmulShapeTiling()->GetTiling();
            uint32_t cacheA1Size = tiling.GetStepM() * tiling.GetStepKa();
            cacheA1Factor_ = (tiling.GetDepthA1() / cacheA1Size - 1) & 1;
            uint32_t cacheB1Size = tiling.GetStepN() * tiling.GetStepKb();
            cacheB1Factor_ = (tiling.GetDepthB1() / cacheB1Size - 1) & 1;
        }
    }

    [aicore] inline void Init(const __attribute__((cce_global)) TCubeTiling* gmCubeTiling, TPipe* tpipe)
    {
        TCubeTiling cubeTiling;
        CopyTiling<A_TYPE, B_TYPE, MM_CFG>(gmCubeTiling, cubeTiling);
        Init(&cubeTiling, tpipe);
    }

    [aicore] inline void Reset()
    {
        isFirstIter_ = true;
    }
protected:
    [aicore] inline bool MoveNext()
    {
        if (__builtin_expect(!!(isFirstIter_), 0)) {
            return MoveOnFirstIterate();
        } else {
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                if (__builtin_expect(!!(cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() == static_cast<int>(IterateOrder::ORDER_M)), 1)) {
                    return MoveOnIterateOrderM();
                } else {




                      ;
                    return MoveOnIterateOrderN();
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                return MoveOnIterateOrderM();
            } else {
                return MoveOnIterateOrderN();
            }
        }
    }

    [aicore] inline bool MoveOnFirstIterate()
    {
        isFirstIter_ = false;
        cast_to_MLoop()->OuterStart();
        cast_to_MLoop()->InnerStart();
        cast_to_NLoop()->OuterStart();
        cast_to_NLoop()->InnerStart();
        return true;
    }

    [aicore] inline bool MoveOnIterateOrderM()
    {

        if (!cast_to_NLoop()->InnerNext()) {
            cast_to_NLoop()->InnerStart();

            if (!cast_to_MLoop()->InnerNext()) {
                if constexpr (!PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos)) {
                    if ((cast_to_KLoop()->IsAKL1FullLoad() && !cast_to_MLoop()->IsAML1FullLoad()) ||
                        (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                        cast_to_CopyCubeInA()->ClearLoadData();
                    }
                }


                if (!cast_to_MLoop()->OuterNext()) {
                    if constexpr (!PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos)) {
                        if ((cast_to_KLoop()->IsBKL1FullLoad() && !cast_to_NLoop()->IsBNL1FullLoad()) ||
                            (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                            cast_to_CopyCubeInB()->ClearLoadData();
                        }
                    }
                    cast_to_MLoop()->OuterStart();
                    cast_to_MLoop()->InnerStart();

                    if (!cast_to_NLoop()->OuterNext()) {
                        return false;
                    }

                    cast_to_NLoop()->InnerStart();
                }
            }
        }
        return true;
    }

    [aicore] inline bool MoveOnIterateOrderN()
    {

        if (!cast_to_MLoop()->InnerNext()) {
            cast_to_MLoop()->InnerStart();

            if (!cast_to_NLoop()->InnerNext()) {
                if constexpr (!PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos)) {
                    if ((cast_to_KLoop()->IsBKL1FullLoad() && !cast_to_NLoop()->IsBNL1FullLoad()) ||
                        (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                        cast_to_CopyCubeInB()->ClearLoadData();
                    }
                }


                if (!cast_to_NLoop()->OuterNext()) {
                    if constexpr (!PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos)) {
                        if ((cast_to_KLoop()->IsAKL1FullLoad() && !cast_to_MLoop()->IsAML1FullLoad()) ||
                            (cast_to_MLoop()->IsLastOuterIter() && cast_to_NLoop()->IsLastOuterIter())) {
                            cast_to_CopyCubeInA()->ClearLoadData();
                        }
                    }
                    cast_to_NLoop()->OuterStart();
                    cast_to_NLoop()->InnerStart();

                    if (!cast_to_MLoop()->OuterNext()) {
                        return false;
                    }

                    cast_to_MLoop()->InnerStart();
                }
            }
        }
        return true;
    }

    [aicore] inline void CopyIn(LocalTensor<TransAT>& a1, LocalTensor<TransBT>& b1)
    {
        a1 = cast_to_CopyCubeInA()->LoadData(cast_to_MLoop()->GetInnerIdx(), cast_to_KLoop()->GetInnerStartIdx(),
            cast_to_MLoop()->GetTileShape(), cast_to_KLoop()->GetTileShapeA());
        b1 = cast_to_CopyCubeInB()->LoadData(cast_to_KLoop()->GetInnerStartIdx(), cast_to_NLoop()->GetInnerIdx(),
            cast_to_KLoop()->GetTileShapeB(), cast_to_NLoop()->GetTileShape());

        if constexpr (MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape()) {
            cast_to_MatmulCrossCoreSync()->WaitL1Ready();
        }

        DoPreloadLoad();
    }

    [aicore] inline void SplitPrepare(const bool enPartialSum, const bool isATranspose, const bool isBTranspose,
        SplitParams& aL0Params, SplitParams& bL0Params, bool& sL0CInit, bool& sL0CLast)
    {
        UpdateSplitParams(aL0Params, bL0Params);
        UpdateComputeParams(enPartialSum, sL0CInit, sL0CLast);
        cast_to_LoadToA2()->Prepare(isATranspose, aL0Params.kAxisL1Len, aL0Params.axisL1Len);
        cast_to_LoadToB2()->Prepare(isBTranspose, bL0Params.kAxisL1Len);
    }

    [aicore] inline LocalTensor<TransAT> SplitA(const LocalTensor<TransAT>& a1,
        const SplitParams& aL0Params, const bool isATranspose)
    {
        if constexpr (DoMatmulSpecialMDL(MM_CFG) || MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            LocalTensor<TransAT> a2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
            cast_to_LoadToA2()->Load(a2, a1, aL0Params.axisL1Len, aL0Params.kAxisL1Len, aL0Params.axisL0Len,
                cast_to_KLoop()->GetBaseShape(), aL0Params.axisL1Offset, aL0Params.kAxisL1Offset, isATranspose);
            return a2;
        } else {
            auto posA = cast_to_MLoop()->GetInnerIdx() * cast_to_KLoop()->GetTotalIter() +
                cast_to_KLoop()->GetInnerIdx();
            int32_t kL0Len = cast_to_KLoop()->GetBaseShape();

            if (!(cast_to_TBufPoolL0()->template Hit<TPosition::A2>(posA))) {
                LocalTensor<TransAT> a2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
                cast_to_LoadToA2()->Load(a2, a1, aL0Params.axisL1Len, aL0Params.kAxisL1Len,
                    aL0Params.axisL0Len, kL0Len, aL0Params.axisL1Offset, aL0Params.kAxisL1Offset, isATranspose);
                return a2;
            } else {
                return cast_to_TBufPoolL0()->template GetBuffer<TPosition::A2, TransAT>();
            }
        }
    }

    [aicore] inline LocalTensor<TransBT> SplitB(const LocalTensor<TransBT>& b1,
        const SplitParams& bL0Params, const bool isBTranspose)
    {
        if constexpr (DoMatmulSpecialMDL(MM_CFG) || MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            LocalTensor<TransBT> b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();

            cast_to_LoadToB2()->Load(b2, b1, bL0Params.axisL1Len, bL0Params.kAxisL1Len,
                bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(), bL0Params.axisL1Offset,
                bL0Params.kAxisL1Offset, isBTranspose);
            return b2;
        } else {
            auto posB = cast_to_NLoop()->GetInnerIdx() * cast_to_KLoop()->GetTotalIter() +
                cast_to_KLoop()->GetInnerIdx();
            int32_t kL0Len = cast_to_KLoop()->GetBaseShape();
            if constexpr (HasSparseIndex<B_TYPE>()) {
                if (!(cast_to_TBufPoolL0()->template Hit<TPosition::B2>(posB))) {
                    LocalTensor<TransBT> b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
                    cast_to_LoadToB2()->Load(b2, b1, bL0Params.axisL1Len, bL0Params.kAxisL1Len,
                        bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(), bL0Params.axisL1Offset,
                        bL0Params.kAxisL1Offset, isBTranspose, cast_to_CopyCubeInB()->GetSparseIndex());
                    return b2;
                } else {
                    return cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
                }
            } else {
                if (!(cast_to_TBufPoolL0()->template Hit<TPosition::B2>(posB))) {
                    LocalTensor<TransBT> b2 = cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
                    cast_to_LoadToB2()->Load(b2, b1, bL0Params.axisL1Len, bL0Params.kAxisL1Len,
                        bL0Params.axisL0Len, cast_to_KLoop()->GetBaseShape(), bL0Params.axisL1Offset,
                        bL0Params.kAxisL1Offset, isBTranspose);
                    return b2;
                } else {
                    return cast_to_TBufPoolL0()->template GetBuffer<TPosition::B2, TransBT>();
                }
            }
        }
    }

    [aicore] inline void CubeCompute(const LocalTensor<L0cT>& cMatrix, const LocalTensor<TransAT>& a2,
        const LocalTensor<TransBT>& b2, const uint16_t madM, const uint16_t madN, const uint16_t madK,
        const bool isATranspose, const bool isBTranspose, const bool sL0CInit, const bool sL0CLast)
    {
        int32_t kInnerStartIdx = IsMDLKFullLoad() ? 0 : cast_to_KLoop()->GetInnerStartIdx();
        auto unitFlag = cast_to_MatmulUnitFlag()->GetUnitFlag(sL0CLast && (cast_to_KLoop()->GetInnerIdx() ==
            kInnerStartIdx + cast_to_KLoop()->GetInnerIter() - 1));
        bool cmatrixSource;
        bool cmatrixInitVal;
        UpdateMmadComputeParams(kInnerStartIdx, sL0CInit, cmatrixSource, cmatrixInitVal);
        if constexpr (HasSparseIndex<B_TYPE>()) {
            cast_to_MmadCompute()->template Compute<true>(cMatrix,
                a2, b2, madM, madK, madN, isATranspose, isBTranspose, unitFlag, cmatrixSource, cmatrixInitVal);
        } else {
            cast_to_MmadCompute()->Compute(cMatrix, a2, b2,
                madM, madK, madN, isATranspose, isBTranspose, unitFlag, cmatrixSource, cmatrixInitVal);
        }
    }

    [aicore] inline void ResetCopyInBuffer()
    {

        if constexpr (!PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos)) {
            if (!cast_to_KLoop()->IsAKL1FullLoad()) {
                cast_to_CopyCubeInA()->Reset();
            }
        }
        if constexpr (!PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos)) {
            if (!cast_to_KLoop()->IsBKL1FullLoad()) {
                cast_to_CopyCubeInB()->Reset();
            }
        }
    }

    [aicore] inline void UpdateComputeParams(const bool enPartialSum, bool& sL0CInit, bool& sL0CLast)
    {
        if (__builtin_expect(!!(cast_to_KLoop()->FirstOuterIter()), 0)) {
            sL0CInit = !enPartialSum;
        }
        if constexpr (EnUnitFlag(MM_CFG)) {
            sL0CLast = cast_to_KLoop()->LastOuterIter();
        }
    }

    [aicore] inline constexpr bool IsMDLKFullLoad()
    {
        if constexpr (IsStaticTilingEnable(MM_CFG)) {
            const auto& tiling = cast_to_MatmulShapeTiling()->GetTiling();
            return (tiling.GetStepKa() < tiling.GetStepKb() ? tiling.GetStepKa() : tiling.GetStepKb()) *
                tiling.GetBaseK() >= tiling.GetSingleCoreK();
        }
        return false;
    }

    [aicore] inline void ClearL1BufferCache(int32_t& curKaOuterIdx, int32_t& curKbOuterIdx)
    {
        if constexpr (!PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos) && ToMatmulConfig(MM_CFG).doMTE2Preload != PRELOAD_M &&
            ToMatmulConfig(MM_CFG).doMTE2Preload != PRELOAD_N) {
            int32_t curKaIdx = cast_to_KLoop()->GetNextOuterKaIdx();

            if (curKaIdx != curKaOuterIdx && !cast_to_KLoop()->IsAKL1FullLoad()) {
                cast_to_CopyCubeInA()->ClearLoadData();
                curKaOuterIdx = curKaIdx;
            }
        }
        if constexpr (!PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos) && ToMatmulConfig(MM_CFG).doMTE2Preload != PRELOAD_M &&
            ToMatmulConfig(MM_CFG).doMTE2Preload != PRELOAD_N) {

            int32_t curKbIdx = cast_to_KLoop()->GetNextOuterKbIdx();
            if (curKbIdx != curKbOuterIdx && !cast_to_KLoop()->IsBKL1FullLoad()) {
                cast_to_CopyCubeInB()->ClearLoadData();
                curKbOuterIdx = curKbIdx;
            }
        }
    }

    [aicore] inline SplitParams InitSplitAParams()
    {
        SplitParams aL0Params;
        int32_t tilingBaseM = cast_to_MatmulShapeTiling()->GetTiling().GetBaseM();
        if constexpr (PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos)) {
            aL0Params.axisL1Offset = cast_to_MLoop()->GetInnerIdx() * tilingBaseM;

            if constexpr (IsFullStaticTiling(MM_CFG) || MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape()) {
                aL0Params.axisL1Len = cast_to_MatmulShapeInfo()->GetOrgM() != -1 ?
                cast_to_MatmulShapeInfo()->GetOrgM() : cast_to_MatmulShapeInfo()->GetSingleCoreM();
                aL0Params.kAxisL1Len = cast_to_MatmulShapeInfo()->GetOrgKa() != -1 ?
                cast_to_MatmulShapeInfo()->GetOrgKa() : cast_to_MatmulShapeInfo()->GetSingleCoreK();
