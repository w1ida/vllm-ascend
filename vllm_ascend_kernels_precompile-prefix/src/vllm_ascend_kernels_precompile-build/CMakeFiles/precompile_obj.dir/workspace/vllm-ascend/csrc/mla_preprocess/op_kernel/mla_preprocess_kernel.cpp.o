            FixpipeL0CToGm(gm, co1Local[co1Offset], cast_to_MLoop()->GetInnerIdx() + 1,
                cast_to_NLoop()->GetInnerIdx(), enAtomic, enSequentialWrite);
        } else {
            FixpipeL0CToGm(gm, co1Local, cast_to_MLoop()->GetInnerIdx(), cast_to_NLoop()->GetInnerIdx(),
                enAtomic, enSequentialWrite);
        }
        cast_to_CubeOutBuffer()->FreeTensor(co1Local);
    }

    [aicore] inline void FixpipeL0CToGm(const GlobalTensor<DstT>& gm, const LocalTensor<L0cT>& co1Local,
        int32_t curM, int32_t curN, uint8_t enAtomic, bool enSequentialWrite)
    {
        if constexpr (C_TYPE::format != CubeFormat::ND && C_TYPE::format != CubeFormat::ND_ALIGN &&
            C_TYPE::format != CubeFormat::NZ && C_TYPE::format != CubeFormat::COLUMN_MAJOR) {

                                                                                                                   ;
        }
        if (enAtomic == ATOMIC_ADD) {
            SetAtomicAdd<DstT>();
        } else if (enAtomic == ATOMIC_MAX) {
            SetAtomicMax<DstT>();
        } else if (enAtomic == ATOMIC_MIN) {
            SetAtomicMin<DstT>();
        }
        if (enSequentialWrite) {
            cast_to_CopyCubeOut()->template Copy<true>(gm, co1Local, curM, curN,
                cast_to_MLoop()->GetBaseShape(), cast_to_NLoop()->GetBaseShape(),
                cast_to_MLoop()->GetBaseBlockShape(), cast_to_NLoop()->GetBaseBlockShape());
        } else {
            cast_to_CopyCubeOut()->template Copy<false>(gm, co1Local, curM, curN,
                cast_to_MLoop()->GetBaseShape(), cast_to_NLoop()->GetBaseShape(),
                cast_to_MLoop()->GetBaseBlockShape(), cast_to_NLoop()->GetBaseBlockShape());
        }

        if (enAtomic != 0) {
            SetAtomicNone();
        }
    }
protected:
    [aicore] inline uint32_t GetL0cDbBufferOffset()
    {
        uint32_t baseM = cast_to_MatmulShapeTiling()->GetTiling().GetBaseM();
        uint32_t baseN = cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
        if (cast_to_MatmulShapeInfo()->IsTransposeA()) {
            baseM = CeilAlign(baseM, BASE_MODULE::c0Size_);
        }
        if (!cast_to_MatmulShapeInfo()->IsTransposeB()) {
            baseN = CeilAlign(baseN, BASE_MODULE::c0Size_);
        }
        return static_cast<uint32_t>(baseN * baseM);
