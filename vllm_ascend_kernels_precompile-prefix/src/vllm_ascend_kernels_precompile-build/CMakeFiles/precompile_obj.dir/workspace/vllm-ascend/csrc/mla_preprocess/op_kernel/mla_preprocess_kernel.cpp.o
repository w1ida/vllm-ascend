    using BASE_MODULE = AscendC::Impl::Detail::CopyCubeInMDLBase<IMPL, MM_CFG, INPUT_TYPE>;
    [aicore] inline CopyCubeIn() = default;
    [aicore] inline ~CopyCubeIn() = default;

    [aicore] inline void SetInput(const GlobalTensor<SrcT>& globalMatrix, bool isTranspose = false)
    {
        isFirstIter_ = true;
        BASE_MODULE::SetInput(globalMatrix, isTranspose);
    }

    template <typename ScheduleContext = int>
    [aicore] inline LocalTensor<TransT> LoadData(
        int32_t curRow, int32_t curCol, int32_t tileHeight, int32_t tileWidth, const ScheduleContext& context = {})
    {
        LocalTensor<TransT> l1;
        int32_t posL1 = BASE_MODULE::GetIterIndex(curRow, curCol);
        int32_t bufferPos = cast_to_CopyCubeInParams()->GetBufferPos();
        if (isFirstIter_) {
            isFirstIter_ = false;
            l1 = cast_to_CubeInBuffer()->AllocTensor(bufferPos);
            cast_to_DataCopyUtils()->CopyTileToCube(l1, curRow, curCol, tileHeight, tileWidth);
            cast_to_CubeInBuffer()->EnQue(l1);
            cast_to_CubeInBuffer()->DeQue();
        } else {
            l1 = cast_to_CubeInBuffer()->GetBuffer(posL1, bufferPos);
        }
        return l1;
    }

