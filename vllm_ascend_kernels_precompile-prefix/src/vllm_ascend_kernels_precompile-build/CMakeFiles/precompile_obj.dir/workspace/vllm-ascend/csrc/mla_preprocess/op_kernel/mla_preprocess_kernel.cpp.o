            return false;
        } else {
            ++innerIndex_;
            UpdateInnerParams();
            return !InnerEnd();
        }
    }

    [aicore] inline void InnerStart()
    {
        innerIndex_ = innerStartIdx_;
        UpdateInnerParams();
    }

    [aicore] inline bool InnerEnd()
    {
        return innerIndex_ >= innerStartIdx_ + innerIter_;
    }

    [aicore] inline bool IsLastInnerIter()
    {
        return innerIndex_ == innerStartIdx_ + innerIter_ - 1;
    }

    [aicore] inline uint32_t GetInnerIdx() const
