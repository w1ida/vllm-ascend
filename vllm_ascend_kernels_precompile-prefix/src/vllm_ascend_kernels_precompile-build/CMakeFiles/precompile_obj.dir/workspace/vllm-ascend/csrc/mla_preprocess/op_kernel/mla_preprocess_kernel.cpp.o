        Sub(tmpBuffer1, src[offset1], tmpBuffer1, tiling.splitSize);
        PipeBarrier<PIPE_V>();
        Exp(tmpBuffer1, tmpBuffer1, tiling.splitSize);
        PipeBarrier<PIPE_V>();
        ReduceSumLastNDImpl(reduceSumBuffer, tmpBuffer1, tmpBuffer2, reduceMainParam);
