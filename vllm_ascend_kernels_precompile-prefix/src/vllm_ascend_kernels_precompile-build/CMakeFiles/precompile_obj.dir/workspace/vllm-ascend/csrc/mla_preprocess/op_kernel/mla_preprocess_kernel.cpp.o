private:
    template <class A_TYPE_, class B_TYPE_, class C_TYPE_, class BIAS_TYPE_, const auto &MM_CFG_, class MM_CB_,
        template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY_>
    friend [aicore] inline void SetTPipe(
        MatmulImpl<A_TYPE_, B_TYPE_, C_TYPE_, BIAS_TYPE_, MM_CFG_, MM_CB_, MATMUL_POLICY_> &mm, TPipe* tpipe);

    template <class A_TYPE_, class B_TYPE_, class C_TYPE_, class BIAS_TYPE_, const auto &MM_CFG_, class MM_CB_,
        template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY_>
    friend [aicore] inline void KfcSetIntraAId(
        MatmulImpl<A_TYPE_, B_TYPE_, C_TYPE_, BIAS_TYPE_, MM_CFG_, MM_CB_, MATMUL_POLICY_> &mm, uint8_t intraId);

    template <class A_TYPE_, class B_TYPE_, class C_TYPE_, class BIAS_TYPE_, const auto &MM_CFG_, class MM_CB_,
        template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY_>
    friend [aicore] inline void KfcSetIntraBId(
        MatmulImpl<A_TYPE_, B_TYPE_, C_TYPE_, BIAS_TYPE_, MM_CFG_, MM_CB_, MATMUL_POLICY_> &mm, uint8_t intraId);

    template <class A_TYPE_, class B_TYPE_, class C_TYPE_, class BIAS_TYPE_, const auto &MM_CFG_, class MM_CB_,
        template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY_>
    friend [aicore] inline MatrixL1Addr KfcGetMatrixL1Addr(
        MatmulImpl<A_TYPE_, B_TYPE_, C_TYPE_, BIAS_TYPE_, MM_CFG_, MM_CB_, MATMUL_POLICY_> &mm);

    [aicore] inline void SetIntraAId(uint8_t intraId);
    [aicore] inline void SetIntraBId(uint8_t intraId);

protected:
    [aicore] inline MatrixL1Addr GetMatrixL1Addr();
    typename Impl::Detail::MatmulParams<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, GetMatmulMode(MM_CFG)>::PARAMS var;
    using POLICY = MATMUL_POLICY<MM_CFG, IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE>;
};

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto &MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void SetTPipe(MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY> &mm,
    TPipe* tpipe)
{
    mm.var.tpipe_ = tpipe;
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto &MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void KfcSetIntraAId(MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY> &mm, uint8_t intraId)
{
    mm.SetIntraAId(intraId);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto &MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void KfcSetIntraBId(MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY> &mm, uint8_t intraId)
{
    mm.SetIntraBId(intraId);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto &MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline MatrixL1Addr KfcGetMatrixL1Addr(MatmulImpl<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY> &mm)
{
    struct MatrixL1Addr matrixL1Addr;
    matrixL1Addr = mm.GetMatrixL1Addr();
    return matrixL1Addr;
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto& MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
template <class T>
[aicore] inline void MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::SetSelfDefineData(
    T dataPtr)
{
    cast_to_MatmulUserDefineInfo()->SetSelfDefineData(dataPtr);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto& MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::SetSparseIndex(const GlobalTensor<uint8_t>& indexGlobal)
{

    if constexpr (DoMatmulMDL(MM_CFG) && HasSparseIndex<B_TYPE>()) {
        cast_to_CopyCubeInB()->SetSparseIndex(indexGlobal);
    }

}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto& MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::SetUserDefInfo(
    const uint64_t tilingPtr)
{
    cast_to_MatmulUserDefineInfo()->SetUserDefineInfo(tilingPtr);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto& MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::SetQuantScalar(
    const uint64_t quantScalar)
{
    MatmulQuantProcessor::SetQuantScalar(quantScalar);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto& MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::SetQuantVector(
    const GlobalTensor<uint64_t>& quantTensor)
{
    MatmulQuantProcessor::SetQuantVector(quantTensor);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto &MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::SetIntraAId(uint8_t intraId)
{
    cast_to_MatmulCrossCoreSync()->SetIntraAId(intraId);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto &MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline void MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::SetIntraBId(uint8_t intraId)
{
    cast_to_MatmulCrossCoreSync()->SetIntraBId(intraId);
}

template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto &MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
[aicore] inline MatrixL1Addr MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::GetMatrixL1Addr()
{
    struct MatrixL1Addr matrixL1Addr;
    if constexpr (PhyPosIsUB(A_TYPE::pos)) {
        matrixL1Addr.l1aAddr = cast_to_CubeInBufferA()->GetBufferHeadAddr();
    }
    if constexpr (PhyPosIsUB(B_TYPE::pos)) {
        matrixL1Addr.l1bAddr = cast_to_CubeInBufferB()->GetBufferHeadAddr();
    }

    if (cast_to_MatmulShapeTiling()->GetTiling().IsBias()) {
        matrixL1Addr.l1biasAddr = cast_to_C1Buffer()->GetBufferHeadAddr();
    }
    return matrixL1Addr;
}

