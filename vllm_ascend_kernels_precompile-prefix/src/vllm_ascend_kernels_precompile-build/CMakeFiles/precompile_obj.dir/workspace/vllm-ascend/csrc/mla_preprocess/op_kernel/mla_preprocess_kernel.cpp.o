    template <KFC_Enum funID, bool isAck> [aicore] inline void PostMessage()
    {
        if constexpr (A_TYPE::ibShare && B_TYPE::ibShare) {
                                                                                                  ;
            if (GetSubBlockIdxImpl() == 1) {
                *((uint32_t *)&kfcMsg_.body) = 0;
