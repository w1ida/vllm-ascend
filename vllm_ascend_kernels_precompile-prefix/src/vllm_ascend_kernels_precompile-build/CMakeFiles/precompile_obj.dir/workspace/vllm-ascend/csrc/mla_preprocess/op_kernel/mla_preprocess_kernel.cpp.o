    using TransT = typename A_TYPE::T;
    using BiasT = typename BIAS_TYPE::T;
    using DstT = typename C_TYPE::T;

public:
    using BASE_MODULE =
        AscendC::Impl::Detail::MatmulScheduler<IMPL, A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, CFG<MM_CFG>, POLICY_TYPE>;

    [aicore] inline bool ScheduleOnce(bool enPartialSum)
    {
                                                                                                             ;
    }

    [aicore] inline void Schedule(const GlobalTensor<DstT>& gm,
        uint8_t enAtomic = 0, bool enSequentialWrite = false, bool fakeMsg = false)
    {

        if (fakeMsg) {
            while (BASE_MODULE::ScheduleOnce(false)) {
                BASE_MODULE::GetResult(gm, enAtomic, enSequentialWrite);
            }
        } else {
            ScheduleIntraBlock(gm, enAtomic, enSequentialWrite);
        }

    }

    [aicore] inline void Reset() {}

private:
    [aicore] inline void ScheduleIntraBlock(const GlobalTensor<DstT>& gm, uint8_t enAtomic, bool enSequentialWrite)
    {
        PreSplitB<false>(0);
        PreSplitB<true>(1);
        cast_to_NLoop()->OuterStart();
        do {
            cast_to_MLoop()->template OuterStart<true>();
            do {
                cast_to_NLoop()->InnerStart();
                do {

                    cast_to_CubeOutBuffer()->AllocTensor();
                    Compute<false>();
                    BASE_MODULE::End();

                    cast_to_BiasScheduler()->SetBias(false);
                    Compute<true>();
                    cast_to_CopyCubeInA()->Reset();
                    GetResultImpl(gm, enAtomic, enSequentialWrite);
                } while (cast_to_NLoop()->InnerNext());
                cast_to_CopyCubeInA()->Reset();
            } while (cast_to_MLoop()->template OuterNext<true>());
        } while (cast_to_NLoop()->OuterNext());
    }

    template <bool IS_INTRA_BLOCK = false>
    [aicore] inline void PreSplitB(uint8_t subBlockIdx)
    {
        auto singleCoreK = cast_to_MatmulShapeInfo()->template GetSingleCoreK<IS_INTRA_BLOCK>();
        auto singleCoreN = cast_to_MatmulShapeInfo()->template GetSingleCoreN<IS_INTRA_BLOCK>();
        auto b1 = cast_to_CopyCubeInB()->AsyncLoadData(0, 0, singleCoreK, singleCoreN);
        bool isBTranspose = cast_to_MatmulShapeInfo()->template IsTransposeB<IS_INTRA_BLOCK>();
        auto kAxisL1Len = CeilAlign(singleCoreK, BLOCK_CUBE);
        cast_to_LoadToB2()->Prepare(isBTranspose, kAxisL1Len);
        cast_to_CopyCubeInB()->AwaitLoadData();
        WaitFlag<HardEvent::M_MTE1>(0);
        WaitFlag<HardEvent::M_MTE1>(1);
        auto baseN = cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
        auto baseK = cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
        auto l0bStride = baseN * baseK;
        cast_to_NLoop()->template OuterStart<true, IS_INTRA_BLOCK>();
        int16_t axisL1Offset = 0;
        do {
            auto baseUseN = cast_to_NLoop()->template GetBaseShape<IS_INTRA_BLOCK>();
            cast_to_KLoop()->template OuterStart<IS_INTRA_BLOCK>();
            uint16_t offset = 0;
            int16_t kAxisL1Offset = 0;
            do {
                auto& bufferPool = cast_to_TBufPoolL0()->template Allocate<true>();
                LocalTensor<TransT> b2 = bufferPool.template GetBuffer<TPosition::B2, TransT, true>(subBlockIdx);
                b2 = b2[offset];
                cast_to_LoadToB2()->Load(b2, b1, singleCoreN, kAxisL1Len, baseUseN,
                    cast_to_KLoop()->template GetBaseShape<IS_INTRA_BLOCK>(),
                    axisL1Offset, kAxisL1Offset, isBTranspose);
                offset += l0bStride;
                axisL1Offset += baseN;
                kAxisL1Offset += baseK;
            } while (cast_to_KLoop()->template OuterEnd<IS_INTRA_BLOCK>());
        } while (cast_to_NLoop()->template OuterEnd<false, IS_INTRA_BLOCK>());
        cast_to_CopyCubeInB()->ClearLoadData(b1);
        SetFlag<HardEvent::MTE1_M>(3);
        WaitFlag<HardEvent::MTE1_M>(3);
        SetFlag<HardEvent::M_MTE1>(0);
        SetFlag<HardEvent::M_MTE1>(1);
    }

    template <bool IS_INTRA_BLOCK = false>
    [aicore] inline void Compute()
    {
        auto tiling = cast_to_MatmulShapeTiling()->GetTiling();

        SplitParams aL0Params = BASE_MODULE::template InitSplitAParams<IS_INTRA_BLOCK>();
        SplitParams bL0Params = BASE_MODULE::template InitSplitBParams<IS_INTRA_BLOCK>();


        cast_to_KLoop()->template OuterStart<IS_INTRA_BLOCK>();
        do {
            int32_t kOuterIdx = cast_to_KLoop()->template GetOuterIdx<IS_INTRA_BLOCK>();

            LocalTensor<TransT> a1 = cast_to_CopyCubeInA()->LoadData(
                cast_to_MLoop()->template GetOuterIdx<true>(),
                kOuterIdx, cast_to_MLoop()->template GetTileShape<IS_INTRA_BLOCK>(),
                cast_to_KLoop()->template GetTileShapeA<IS_INTRA_BLOCK>());
            if constexpr (!IS_INTRA_BLOCK) {

                LocalTensor<BiasT> bias = cast_to_BiasScheduler()->CopyIn(
                    cast_to_NLoop()->template GetBaseShape<false>(), 1,
                    cast_to_NLoop()->GetInnerIdx() * tiling.GetBaseN());
                cast_to_BiasScheduler()->SplitLoad(bias, bL0Params.axisL0Len);
            }

            BASE_MODULE::template UpdateSplitParams<IS_INTRA_BLOCK>(aL0Params, bL0Params);
            int32_t sL0CInit = 0;
            int32_t sL0CLast = 0;
            if constexpr (!IS_INTRA_BLOCK) {
                if (__builtin_expect(!!(kOuterIdx == 0), 0)) {
                    sL0CInit = 1;
                }
            } else {
                if constexpr (EnUnitFlag(MM_CFG)) {
                    sL0CLast = (kOuterIdx == cast_to_KLoop()->template GetTotalIter<true>() - 1 ) ? 1 : 0;
                }
            }

            bool isATranspose = cast_to_MatmulShapeInfo()->template IsTransposeA<IS_INTRA_BLOCK>();
            cast_to_LoadToA2()->Prepare(isATranspose, aL0Params.kAxisL1Len, aL0Params.axisL1Len);
            int32_t kL0Len = cast_to_KLoop()->template GetTileShapeA<IS_INTRA_BLOCK>();


            auto& bufferPool = cast_to_TBufPoolL0()->Allocate();
            LocalTensor<TransT> a2 = bufferPool.template GetBuffer<TPosition::A2, TransT>();
            cast_to_LoadToA2()->Load(a2, a1, aL0Params.axisL1Len, aL0Params.kAxisL1Len,
                aL0Params.axisL0Len, kL0Len, aL0Params.axisL1Offset, aL0Params.kAxisL1Offset, isATranspose);
            auto kTotalIter = cast_to_KLoop()->template GetTotalIter<IS_INTRA_BLOCK>();
            int32_t posB =
                (kOuterIdx + cast_to_NLoop()->GetInnerIdx() * kTotalIter) % (tiling.GetStepN() * kTotalIter);
            LocalTensor<TransT> b2 =
                bufferPool.template GetBuffer<TPosition::B2, TransT, IS_INTRA_BLOCK>((uint8_t)IS_INTRA_BLOCK);
            b2 = b2[posB * tiling.GetBaseN() * tiling.GetBaseK()];
            bufferPool.EnQue();
            bufferPool.DeQue();

            uint8_t unitFlag = 0;
            if constexpr (IS_INTRA_BLOCK) {
                unitFlag = cast_to_MatmulUnitFlag()->GetUnitFlag(sL0CLast);
            }
            bool isBias;
            bool cmatrixSource;
            bool cmatrixInitVal;
            BASE_MODULE::UpdateBiasParams(IS_INTRA_BLOCK, sL0CInit, cmatrixSource, cmatrixInitVal, isBias);
            cast_to_MmadCompute()->Compute(cast_to_CubeOutBuffer()->GetTensor(), a2, b2,
                aL0Params.axisL0Len, kL0Len, bL0Params.axisL0Len, isATranspose,
                cast_to_MatmulShapeInfo()->template IsTransposeB<IS_INTRA_BLOCK>(),
                unitFlag, cmatrixSource, cmatrixInitVal, isBias);
            bufferPool.Free();
            if constexpr (!IS_INTRA_BLOCK) {
                cast_to_BiasScheduler()->Free();
            }

            cast_to_CopyCubeInA()->ClearLoadData(
                a1, cast_to_MLoop()->template GetOuterIdx<true>(), kOuterIdx);
        } while (cast_to_KLoop()->template OuterNext<IS_INTRA_BLOCK>());
    }

    [aicore] inline void GetResultImpl(const GlobalTensor<DstT>& gm, uint8_t enAtomic = 0,
        bool enSequentialWrite = false)
    {
        auto co1Local = cast_to_CubeOutBuffer()->GetTensor();
        cast_to_CubeOutBuffer()->EnQue(co1Local);
        cast_to_CubeOutBuffer()->DeQue();
        BASE_MODULE::SetAtomic(enAtomic);

        if (enSequentialWrite) {
            cast_to_CopyCubeOut()->template Copy<true>(gm, co1Local,
                cast_to_MLoop()->template GetOuterIdx<true>(), cast_to_NLoop()->GetInnerIdx(),
                cast_to_MLoop()->template GetBaseShape<true>(),
                cast_to_NLoop()->template GetBaseShape<true>(),
                cast_to_MLoop()->template GetBaseBlockShape<true>(),
                cast_to_NLoop()->template GetBaseBlockShape<true>());
        } else {
            cast_to_CopyCubeOut()->template Copy<false>(gm, co1Local,
                cast_to_MLoop()->template GetOuterIdx<true>(), cast_to_NLoop()->GetInnerIdx(),
                cast_to_MLoop()->template GetBaseShape<true>(),
                cast_to_NLoop()->template GetBaseShape<true>(),
                cast_to_MLoop()->template GetBaseBlockShape<true>(),
                cast_to_NLoop()->template GetBaseBlockShape<true>());
        }

        BASE_MODULE::ClearAtomic(enAtomic);
        cast_to_CubeOutBuffer()->FreeTensor(co1Local);
        cast_to_CubeOutBuffer()->Destroy();
    }
};

}
}
