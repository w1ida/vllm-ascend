        SetMaskCount();
        AscendCUtils::SetMask<T>(0, count);
        DuplicateIntrinsicsImpl(dstLocal, scalarValue, 1, DEFAULT_BLK_STRIDE, DEFAULT_REPEAT_STRIDE);
        ResetMask();
        SetMaskNorm();
    }
}
