template <typename InDtype, int8_t CACHE_MODE, DataFormat weightFormat1 = DataFormat::NZ,
          DataFormat weightFormat2 = DataFormat::NZ, DataFormat weightFormat3 = DataFormat::ND>
class MLAOperation
{
    static constexpr uint64_t splitGapC = CACHE_MODE == CACHE_MODE_KVCACHE ? CONST_64 : CONST_0;

public:
    [aicore] inline MLAOperation(const MlaTilingData &mlaParams_, __attribute__((cce_global)) uint8_t* tilingGm)
    {
        blockIdx = AscendC::GetBlockIdx();

        sub_block_idx = static_cast<uint64_t>(GetSubBlockidx());

        vectorBlockIdx = (blockIdx / 2) * 2 + sub_block_idx;
        this->n = mlaParams_.n;
        this->num_core_ = mlaParams_.rmsNumCore1;
        this->num_col_1 = mlaParams_.rmsNumCol1;
        this->num_col_2 = mlaParams_.rmsNumCol2;
        this->num_row = mlaParams_.n;
        this->epsilon_ = 1e-6;
        this->mlaParams = mlaParams_;
    }

    [aicore] inline void Init(__attribute__((cce_global)) uint8_t* hiddenStateGm, __attribute__((cce_global)) uint8_t* wdqkvGm, __attribute__((cce_global)) uint8_t* gamma2Gm,
                                __attribute__((cce_global)) uint8_t* beta2Gm, __attribute__((cce_global)) uint8_t* gamma3Gm,
                                __attribute__((cce_global)) uint8_t* sin1Gm, __attribute__((cce_global)) uint8_t* cos1Gm, __attribute__((cce_global)) uint8_t* sin2Gm, __attribute__((cce_global)) uint8_t* cos2Gm, __attribute__((cce_global)) uint8_t* keycacheGm,
                                __attribute__((cce_global)) uint8_t* slotMappingGm, __attribute__((cce_global)) uint8_t* wuqGm, __attribute__((cce_global)) uint8_t* wukGm,
                                __attribute__((cce_global)) uint8_t* qGm, __attribute__((cce_global)) uint8_t* keycacheOutGm, __attribute__((cce_global)) uint8_t* qGm2, __attribute__((cce_global)) uint8_t* keycacheOutGm2, __attribute__((cce_global)) uint8_t* s1Gm,
                                __attribute__((cce_global)) uint8_t* s2Gm, __attribute__((cce_global)) uint8_t* s3Gm)
    {
        gamma3GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(gamma3Gm));
        sin1GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(sin1Gm));
        cos1GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(cos1Gm));
        keycacheGmTensor1.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(keycacheOutGm));
        keycacheGmTensor2.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(keycacheOutGm2));
        slotMappingGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int32_t *>(slotMappingGm));
        s2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(s2Gm));
        s3GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(s3Gm));







        hiddenStateGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(hiddenStateGm));
        wdqkvGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(wdqkvGm));
        gamma2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(gamma2Gm));
        sin2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(sin2Gm));
        cos2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(cos2Gm));
        wuqGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(wuqGm));
        wukGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(wukGm));
        s1GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(s1Gm));
        qGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(qGm));
        qGmTensor2.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(qGm2));
        beta2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(beta2Gm));


        row_work = (num_row + num_core_ - 1) / num_core_;
        row_work_ = 0;
        uint32_t need_core = (num_row + row_work - 1) / row_work;
        if (vectorBlockIdx < need_core - 1) {
            row_work_ = row_work;
        } else if (vectorBlockIdx == need_core - 1) {
            row_work_ = num_row - (need_core - 1) * row_work;
        } else {
