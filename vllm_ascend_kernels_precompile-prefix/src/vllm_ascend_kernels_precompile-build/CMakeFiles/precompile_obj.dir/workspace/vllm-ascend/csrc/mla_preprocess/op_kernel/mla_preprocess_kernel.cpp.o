    [aicore] inline enable_if_t<IsBmmDoubleBuffer<INPUT_TYPE, MM_CFG_ALIAS>()>
    CopyBatchToCubeND(LocalTensor<TransT>& dstTensor, uint32_t matrixStride, int32_t outerIdx, int32_t splitIdx,
