        hiddenStateGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(hiddenStateGm));
        quantScale1GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(quantScale1Gm));
        quantOffset1GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int8_t *>(quantOffset1Gm));
        wdqkvGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int8_t *>(wdqkvGm));
        gamma2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(gamma2Gm));
        quantScale2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(quantScale2Gm));
        quantOffset2GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int8_t *>(quantOffset2Gm));
