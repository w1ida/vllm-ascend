template <class A_TYPE, class B_TYPE, class C_TYPE, class BIAS_TYPE, const auto& MM_CFG, class MM_CB,
    template <const auto& = MM_CFG, typename ...> class MATMUL_POLICY>
template <bool sync, typename T>
[aicore] inline bool MatmulImplBase<A_TYPE, B_TYPE, C_TYPE, BIAS_TYPE, MM_CFG, MM_CB, MATMUL_POLICY>::Iterate(
    bool enPartialSum, const LocalTensor<T>& localCmatrix)
{
    if constexpr (PhyPosIsL0C(C_TYPE::pos)) {
        static_assert((C_TYPE::format == CubeFormat::NZ), "Unsupported format type for output matrix.");
        static_assert((IsSameTypeV<T, L0cT>), "Input localCmatrix's dType must be same as the L0cT.");
        cast_to_CubeOutBuffer()->SetTensor(localCmatrix);
    }
    return cast_to_Scheduler()->ScheduleOnce(enPartialSum);
}
