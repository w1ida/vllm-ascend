    using SrcT = typename INPUT_TYPE::T;
    using TransT = typename INPUT_TYPE::TRANS_T;

public:
    using BASE_MODULE = AscendC::Impl::Detail::BatchCopyCubeInBase<IMPL, MM_CFG, INPUT_TYPE>;

    inline [aicore] BatchCopyCubeIn() = default;
    inline [aicore] ~BatchCopyCubeIn() = default;

    [aicore] inline void Init()
    {
        if constexpr (INPUT_TYPE::isTrans) {
            cast_to_CubeInBuffer()->Init(cast_to_BatchCopyCubeInParams()->GetBatchNum() *
            cast_to_BatchCopyCubeInParams()->template GetSingleSizeAlign<true, INPUT_TYPE::TAG == InputTypeTag::A>(),
            IsBmmDoubleBuffer<INPUT_TYPE, MM_CFG>() ? cast_to_BatchLoop()->GetSplitSize() : 1);
        } else {
            cast_to_CubeInBuffer()->Init(cast_to_BatchCopyCubeInParams()->GetBatchNum() *
            cast_to_BatchCopyCubeInParams()->template GetSingleSizeAlign<false, INPUT_TYPE::TAG == InputTypeTag::B>(),
            IsBmmDoubleBuffer<INPUT_TYPE, MM_CFG>() ? cast_to_BatchLoop()->GetSplitSize() : 1);
        }
    }

    [aicore] inline void BatchLoad(LocalTensor<TransT>& dstTensor, const uint32_t matrixStride,
                                     const int32_t outerIdx, const int32_t splitIdx, const int32_t splitSize)
    {
        if constexpr (IsBmmDoubleBuffer<INPUT_TYPE, MM_CFG>()) {
            if (cast_to_CubeInBuffer()->Hit(0)) {
                dstTensor = cast_to_CubeInBuffer()->GetBuffer(0);
                return;
            } else {
                dstTensor = BASE_MODULE::AllocTensor(cast_to_BatchLoop()->template NeedCache<INPUT_TYPE::TAG>());
            }
        }

        if (cast_to_BatchCopyCubeInParams()->IsTranspose()) {
            CopyBatchToCubeNZ<true, INPUT_TYPE::TAG == InputTypeTag::A>(
                dstTensor, outerIdx, splitIdx, splitSize);
        } else {
            CopyBatchToCubeNZ<false, INPUT_TYPE::TAG == InputTypeTag::B>(
                dstTensor, outerIdx, splitIdx, splitSize);
        }
    }

    [aicore] inline void BatchDestroy(const LocalTensor<TransT>& tensor = LocalTensor<TransT>{})
    {
        if constexpr (IsBmmDoubleBuffer<INPUT_TYPE, MM_CFG>()) {
            cast_to_CubeInBuffer()->FreeTensor(cast_to_BatchLoop()->template NeedCache<INPUT_TYPE::TAG>(), tensor);
            if (cast_to_BatchLoop()->GetSplitSize() != DB_FACTOR) {
                cast_to_CubeInBuffer()->Destroy();
            }
        } else {
            BASE_MODULE::BatchDestroy();
        }
    }

private:
    template <bool IS_TRANS = false, bool IS_KROW = false, const auto& MM_CFG_ALIAS = MM_CFG>
    [aicore] inline enable_if_t<!IsBmmDoubleBuffer<INPUT_TYPE, MM_CFG_ALIAS>()>
    CopyBatchToCubeNZ(LocalTensor<TransT>& dstTensor, int32_t outerIdx, int32_t splitIdx, int32_t splitSize)
    {


        auto alignHeight = CeilAlign(cast_to_BatchCopyCubeInParams()->template GetSingleHeight<IS_TRANS>(), BLOCK_CUBE);
        auto alignWidth = CeilAlign(cast_to_BatchCopyCubeInParams()->template GetSingleWidth<IS_TRANS>(), c0Size_);


        auto batchNum = cast_to_BatchCopyCubeInParams()->GetBatchNum();
        int32_t batchNumIdx = batchNum / splitSize;

        int64_t srcStride = alignWidth * alignHeight;
        int64_t dstStride = cast_to_BatchCopyCubeInParams()->template GetSingleSizeAlign<IS_TRANS, IS_KROW>();
        int64_t srcOffset = batchNumIdx * splitIdx * srcStride;
        int64_t dstOffset = batchNumIdx * splitIdx * dstStride;

        auto batchBlock = splitIdx == 0 ? batchNumIdx : batchNum - batchNumIdx;


        bool iskRowDirec = IS_KROW && IsSupportB8<TransT>();
        auto batchOffset = outerIdx * cast_to_BatchCopyCubeInParams()->GetBatchMainBlock() * srcStride;
        GlobalTensor<SrcT> srcGlobal;
        srcGlobal.SetGlobalBuffer(cast_to_MatmulTensorInfo()->GetGlobalTensor().address_);
        srcGlobal.SetAddr(batchOffset);
        for (int i = 0; i < batchBlock; ++i) {
            cast_to_DataCopyWrapper()->CopyNZ2NZ(
                dstTensor[dstOffset], srcGlobal[srcOffset], 0, 0,
                alignHeight, alignWidth, alignHeight, iskRowDirec);
            dstOffset += dstStride;
            srcOffset += srcStride;
        }
    }

    template <bool IS_TRANS = false, bool IS_KROW = false, const auto& MM_CFG_ALIAS = MM_CFG>
    [aicore] inline enable_if_t<IsBmmDoubleBuffer<INPUT_TYPE, MM_CFG_ALIAS>()>
    CopyBatchToCubeNZ(LocalTensor<TransT>& dstTensor, int32_t outerIdx, int32_t splitIdx, int32_t splitSize)
    {


        auto alignHeight = CeilAlign(cast_to_BatchCopyCubeInParams()->template GetSingleHeight<IS_TRANS>(), BLOCK_CUBE);
        auto alignWidth = CeilAlign(cast_to_BatchCopyCubeInParams()->template GetSingleWidth<IS_TRANS>(), c0Size_);


        auto batchNum = cast_to_BatchLoop()->template GetBatchNumBySplitIdx<INPUT_TYPE::TAG>(splitIdx);
        int64_t srcStride = alignWidth * alignHeight;
        int64_t dstStride = cast_to_BatchCopyCubeInParams()->template GetSingleSizeAlign<IS_TRANS, IS_KROW>();
        int64_t srcOffset = 0;
        if (cast_to_BatchCopyCubeInParams()->GetBatchNum() > cast_to_BatchLoop()->GetSplitBatchNum()) {
            if (splitIdx == 1) {
                srcOffset = cast_to_BatchLoop()->GetSplitBatchNum() * srcStride;
            }
        }
        int64_t dstOffset = 0;


        bool iskRowDirec = IS_KROW && IsSupportB8<TransT>();
        auto batchOffset = outerIdx * cast_to_BatchCopyCubeInParams()->GetBatchNum() * srcStride;
        GlobalTensor<SrcT> srcGlobal;
        srcGlobal.SetGlobalBuffer(cast_to_MatmulTensorInfo()->GetGlobalTensor().address_);
        srcGlobal.SetAddr(batchOffset);
        for (int i = 0; i < batchNum; ++i) {
            cast_to_DataCopyWrapper()->CopyNZ2NZ(
                dstTensor[dstOffset], srcGlobal[srcOffset], 0, 0,
                alignHeight, alignWidth, alignHeight, iskRowDirec);
            dstOffset += dstStride;
            srcOffset += srcStride;
        }
    }
private:
    constexpr static int32_t c0Size_ = AuxGetC0Size<TransT>();
};

}
