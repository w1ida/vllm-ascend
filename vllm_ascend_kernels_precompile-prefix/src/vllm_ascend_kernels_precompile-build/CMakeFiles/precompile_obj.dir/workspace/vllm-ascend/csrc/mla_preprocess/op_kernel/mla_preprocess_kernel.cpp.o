    }

    [aicore] inline constexpr bool IsInTrianMatmul() {
        if constexpr (POLICY_TYPE == PolicyType::MATMUL_UPPER_TRIANGULAR) {
            CheckSupportTrianMatmul();
            if (cast_to_MLoop()->GetInnerIdx() > cast_to_NLoop()->GetInnerIdx()) {
                return false;
            }
        } else if constexpr (POLICY_TYPE == PolicyType::MATMUL_LOWER_TRIANGULAR) {
            CheckSupportTrianMatmul();
            if (cast_to_MLoop()->GetInnerIdx() < cast_to_NLoop()->GetInnerIdx()) {
                return false;
            }
        }
        return true;
    }

    [aicore] inline void GetResultImpl(
        const LocalTensor<DstT>& co2Local, uint8_t enAtomic, bool enSequentialWrite)
    {
        (void)(enAtomic);
        auto co1Local = cast_to_CubeOutBuffer()->GetTensor();
        cast_to_CubeOutBuffer()->EnQue(co1Local);
        cast_to_CubeOutBuffer()->DeQue();
        if (!IsInTrianMatmul()) {
            cast_to_CubeOutBuffer()->FreeTensor(co1Local);
            return;
        }
        if (enSequentialWrite) {
