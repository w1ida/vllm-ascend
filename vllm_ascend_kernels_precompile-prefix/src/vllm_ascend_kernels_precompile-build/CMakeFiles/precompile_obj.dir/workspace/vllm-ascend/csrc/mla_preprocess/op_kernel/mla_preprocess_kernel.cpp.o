          QuantMode quantMode = QuantMode::PER_TENSOR_ASYMM_QUANT>
class MLAOperation
{
    static constexpr bool mm1WithSyncAll = (quantMode == QuantMode::PER_TOKEN_SYMM_QUANT);
    static constexpr uint64_t splitGapC = CACHE_MODE == CACHE_MODE_KVCACHE ? CONST_64 : CONST_0;
    using Q_OUT_DTYPE = typename std::conditional_t<CACHE_MODE == CACHE_MODE_INT8_NZCACHE, int8_t, InDtype>;
    using K_NOPE_DTYPE = typename std::conditional_t<CACHE_MODE == CACHE_MODE_INT8_NZCACHE, int8_t, InDtype>;

public:
    [aicore] inline MLAOperation(const MlaTilingData &mlaParams_, __attribute__((cce_global)) uint8_t* tilingGm)
    {
        blockIdx = AscendC::GetBlockIdx();

        sub_block_idx = static_cast<uint64_t>(GetSubBlockidx());

        vectorBlockIdx = (blockIdx / 2) * 2 + sub_block_idx;
        this->n = mlaParams_.n;
        this->num_core_ = mlaParams_.rmsNumCore1;
        this->num_col_1 = mlaParams_.rmsNumCol1;
        this->num_col_2 = mlaParams_.rmsNumCol2;
        this->num_row = mlaParams_.n;
        this->epsilon_ = 1e-6;
        this->mlaParams = mlaParams_;
        this->hiddenStateDim = mlaParams_.hiddenStateDim;
    }

    [aicore] inline void Init(__attribute__((cce_global)) uint8_t* hiddenStateGm, __attribute__((cce_global)) uint8_t* quantScale1Gm,
                                __attribute__((cce_global)) uint8_t* quantOffset1Gm, __attribute__((cce_global)) uint8_t* wdqkvGm, __attribute__((cce_global)) uint8_t* bias1Gm, __attribute__((cce_global)) uint8_t* gamma2Gm,
                                __attribute__((cce_global)) uint8_t* beta2Gm, __attribute__((cce_global)) uint8_t* quantScale2Gm, __attribute__((cce_global)) uint8_t* quantOffset2Gm, __attribute__((cce_global)) uint8_t* gamma3Gm,
                                __attribute__((cce_global)) uint8_t* sin1Gm, __attribute__((cce_global)) uint8_t* cos1Gm, __attribute__((cce_global)) uint8_t* sin2Gm, __attribute__((cce_global)) uint8_t* cos2Gm, __attribute__((cce_global)) uint8_t* keycacheGm,
                                __attribute__((cce_global)) uint8_t* slotMappingGm, __attribute__((cce_global)) uint8_t* wuqGm, __attribute__((cce_global)) uint8_t* bias2Gm, __attribute__((cce_global)) uint8_t* wukGm,
                                __attribute__((cce_global)) uint8_t* descale1Gm, __attribute__((cce_global)) uint8_t* descale2Gm, __attribute__((cce_global)) uint8_t* gmCtkvScale, __attribute__((cce_global)) uint8_t* gmQnopeScale,
                                __attribute__((cce_global)) uint8_t* qGm, __attribute__((cce_global)) uint8_t* keycacheOutGm, __attribute__((cce_global)) uint8_t* qGm2, __attribute__((cce_global)) uint8_t* keycacheOutGm2, __attribute__((cce_global)) uint8_t* s1Gm,
                                __attribute__((cce_global)) uint8_t* s2Gm, __attribute__((cce_global)) uint8_t* s3Gm, __attribute__((cce_global)) uint8_t* s4Gm, __attribute__((cce_global)) uint8_t* s5Gm)
    {
