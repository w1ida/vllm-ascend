                    cast_to_MatmulShapeTiling()->GetTiling().IsBias() *
                    cast_to_MatmulShapeTiling()->GetTiling().GetSingleCoreN() * sizeof(BiasT);
                batchInner = TOTAL_L1_SIZE / singleBatchSize;
