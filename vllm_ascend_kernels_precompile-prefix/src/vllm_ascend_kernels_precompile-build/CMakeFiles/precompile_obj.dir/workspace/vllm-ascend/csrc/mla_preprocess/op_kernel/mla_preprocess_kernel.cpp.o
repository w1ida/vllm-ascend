    [aicore] LayerNormGradParams(LayerNormGradTiling &tiling, LocalTensor<float> &stackBuffer)
        : bLength(tiling.bLength),
          sLength(tiling.sLength),
          hLength(tiling.hLength),
          loopNum(tiling.loopNum),
