[aicore] constexpr void GetMxMatmulApiTiling(MatmulApiStaticTiling &tiling, int32_t l1Size)
{
# 489 "/usr/local/Ascend/cann-8.5.0/aarch64-linux/tikcpp/tikcfw/include/adv_api/matmul/../../../impl/adv_api/tiling/matmul/matmul_constant_tiling_impl.h"
