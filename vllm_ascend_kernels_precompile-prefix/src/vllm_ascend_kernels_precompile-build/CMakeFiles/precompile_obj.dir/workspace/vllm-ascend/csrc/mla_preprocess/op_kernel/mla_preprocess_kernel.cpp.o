        set_atomic_f16();
    } else if constexpr(IsSameType<T, int16_t>::value) {
        set_atomic_s16();
    } else if constexpr(IsSameType<T, int32_t>::value) {
        set_atomic_s32();
    } else if constexpr(IsSameType<T, int8_t>::value) {
        set_atomic_s8();
    } else if constexpr(IsSameType<T, bfloat16_t>::value) {
        set_atomic_bf16();
    }
}


