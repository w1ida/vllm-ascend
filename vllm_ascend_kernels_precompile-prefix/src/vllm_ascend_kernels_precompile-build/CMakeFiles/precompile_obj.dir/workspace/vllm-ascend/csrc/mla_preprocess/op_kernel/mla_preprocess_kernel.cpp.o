                aL0Params.axisL1Len = cast_to_MatmulShapeInfo()->GetSingleCoreM();
                aL0Params.kAxisL1Len = cast_to_MatmulShapeInfo()->GetSingleCoreK();
            }
        } else if constexpr (IsStaticPaddingEnable(MM_CFG)){
            aL0Params.axisL1Len = cast_to_MatmulShapeTiling()->GetTiling().GetStepM() * tilingBaseM;
            aL0Params.kAxisL1Len = cast_to_MatmulShapeTiling()->GetTiling().GetStepKa() *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
            aL0Params.axisL1Offset = (cast_to_MLoop()->GetInnerIdx() - cast_to_MLoop()->GetOuterIdx() *
                cast_to_MatmulShapeTiling()->GetTiling().GetStepM()) * tilingBaseM;
        } else {
            aL0Params.axisL1Len = cast_to_MLoop()->GetTileBlockShape() * BLOCK_CUBE;
            aL0Params.axisL1Offset = (cast_to_MLoop()->GetInnerIdx() - cast_to_MLoop()->GetOuterIdx() *
                cast_to_MatmulShapeTiling()->GetTiling().GetStepM()) * tilingBaseM;
        }

        if constexpr (IMPL::POLICY::POLICY_TYPE == PolicyType::MATMUL_NBUFFER_33) {
            aL0Params.axisL1Offset = 0;
        }
        if constexpr (IsStaticPaddingEnable(MM_CFG)) {
            aL0Params.axisL0Len = tilingBaseM;
        } else {
            aL0Params.axisL0Len = cast_to_MLoop()->GetBaseShape();
        }
        if constexpr ((A_TYPE::format == CubeFormat::VECTOR) || (A_TYPE::format == CubeFormat::SCALAR)) {
            aL0Params.axisL0Len = 1;
        } else {
            if constexpr (!MatmulFeatureTrait<MM_CFG>::IsSupportDisableGemvMode()) {
                if (aL0Params.axisL0Len == 1) {
                    aL0Params.axisL0Len = BLOCK_CUBE;
                }
            }
        }
        return aL0Params;
    }

    [aicore] inline SplitParams InitSplitBParams()
    {
        SplitParams bL0Params;
        int32_t tilingBaseN = cast_to_MatmulShapeTiling()->GetTiling().GetBaseN();
        if constexpr (IsStaticPaddingEnable(MM_CFG)) {
            bL0Params.axisL1Len = cast_to_MatmulShapeTiling()->GetTiling().GetStepN() * tilingBaseN;
            bL0Params.kAxisL1Len = cast_to_MatmulShapeTiling()->GetTiling().GetStepKb() *
                cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
            bL0Params.axisL0Len = tilingBaseN;
        } else {
            bL0Params.axisL1Len = cast_to_NLoop()->GetTileBlockShape() * BLOCK_CUBE;
            bL0Params.axisL0Len = cast_to_NLoop()->GetBaseShape();
        }
        if constexpr (PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos)) {
            bL0Params.axisL1Offset = cast_to_NLoop()->GetInnerIdx() * tilingBaseN;

            if constexpr (IsFullStaticTiling(MM_CFG) || MatmulFeatureTrait<MM_CFG>::IsSupportUBToL1Singleshape()) {
                bL0Params.axisL1Len = cast_to_MatmulShapeInfo()->GetOrgN() != -1 ?
                cast_to_MatmulShapeInfo()->GetOrgN() : cast_to_MatmulShapeInfo()->GetSingleCoreN();
                bL0Params.kAxisL1Len = cast_to_MatmulShapeInfo()->GetOrgKb() != -1 ?
                cast_to_MatmulShapeInfo()->GetOrgKb() : cast_to_MatmulShapeInfo()->GetSingleCoreK();
            } else {
                bL0Params.axisL1Len = cast_to_MatmulShapeInfo()->GetSingleCoreN();
                bL0Params.kAxisL1Len = cast_to_MatmulShapeInfo()->GetSingleCoreK();
            }
        } else {
            if constexpr (!MatmulFeatureTrait<MM_CFG>::IsNeedUB()) {
                if constexpr (IsSameTypeV<TransBT, int8_t>) {
                    int32_t stepN = cast_to_MatmulShapeTiling()->GetTiling().GetStepN();
                    if (tilingBaseN % c0Size_ == 0 || stepN == 1) {
                        bL0Params.axisL1Offset = (cast_to_NLoop()->GetInnerIdx() -
                            cast_to_NLoop()->GetOuterIdx() * stepN) * tilingBaseN;
                    } else {
                        bL0Params.axisL1Offset = (cast_to_NLoop()->GetInnerIdx() -
                            cast_to_NLoop()->GetOuterIdx() * stepN) * CeilAlign(tilingBaseN, c0Size_);
                    }
                } else {
                    bL0Params.axisL1Offset = tilingBaseN * (cast_to_NLoop()->GetInnerIdx() -
                        cast_to_NLoop()->GetOuterIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetStepN());
                }
            } else {
                bL0Params.axisL1Offset = (cast_to_NLoop()->GetInnerIdx() - cast_to_NLoop()->GetOuterIdx() *
                    cast_to_MatmulShapeTiling()->GetTiling().GetStepN()) * tilingBaseN;
            }
        }
        return bL0Params;
    }

    [aicore] inline void UpdateSplitParams(SplitParams& aL0Params, SplitParams& bL0Params)
    {
        int32_t tilingBaseK = cast_to_MatmulShapeTiling()->GetTiling().GetBaseK();
        int32_t kInnerIdx = cast_to_KLoop()->GetInnerStartIdx();
        if constexpr (PhyPosIsL1OrUB<MM_CFG>(A_TYPE::pos)) {
            aL0Params.kAxisL1Offset = kInnerIdx * tilingBaseK;
        } else {
            aL0Params.kAxisL1Len = cast_to_KLoop()->GetTileBlockShapeA() * c0Size_;
            int32_t tilingStepKa = cast_to_MatmulShapeTiling()->GetTiling().GetStepKa();
            aL0Params.kAxisL1Offset = (kInnerIdx - kInnerIdx / tilingStepKa * tilingStepKa) * tilingBaseK;
        }
        if constexpr (PhyPosIsL1OrUB<MM_CFG>(B_TYPE::pos)) {
            bL0Params.kAxisL1Offset = kInnerIdx * tilingBaseK;
        } else {
            bL0Params.kAxisL1Len = cast_to_KLoop()->GetTileBlockShapeB() * c0Size_;
            int32_t tilingStepKb = cast_to_MatmulShapeTiling()->GetTiling().GetStepKb();
            bL0Params.kAxisL1Offset = (kInnerIdx - kInnerIdx / tilingStepKb * tilingStepKb) * tilingBaseK;
        }
    }

    [aicore] inline void UpdateMmadComputeParams(int32_t kInnerStartIdx, bool sL0CInit,
        bool& cmatrixSource, bool& cmatrixInitVal)
    {
        if constexpr (MatmulFeatureTrait<MM_CFG>::IsNeedUB()) {
            if (cast_to_BiasScheduler()->IsBias()) {
                cmatrixSource = false;
                cmatrixInitVal = false;
            } else {
                cmatrixSource = false;
                cmatrixInitVal = cast_to_KLoop()->GetInnerIdx() == kInnerStartIdx && sL0CInit;
            }
        } else {
            if constexpr (ToMatmulConfig(MM_CFG).isPartialOutput) {

                cmatrixSource = cast_to_BiasScheduler()->IsBias();
                cmatrixInitVal = !cast_to_BiasScheduler()->IsBias();
            } else {
                bool isInit= (cast_to_KLoop()->GetInnerIdx() == kInnerStartIdx) && sL0CInit;
                cmatrixSource = cast_to_BiasScheduler()->IsBias() ? isInit : false;
                cmatrixInitVal = cast_to_BiasScheduler()->IsBias() ? false : isInit;
            }
        }
    }

    [aicore] inline void DoPreloadLoad()
    {
        if (cast_to_KLoop()->FirstOuterIter()) {
            if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_M) {
                if (cacheA1Factor_ == 1 && (cast_to_NLoop()->GetInnerIdx() %
                    cast_to_MatmulShapeTiling()->GetTiling().GetStepN() == 0) &&
                    (cast_to_MLoop()->GetInnerIdx() + cast_to_MatmulShapeTiling()->GetTiling().GetStepM() <
                    cast_to_MLoop()->GetTotalIter())) {

                    cast_to_CopyCubeInA()->AsyncLoadData((cast_to_MLoop()->GetInnerIdx() +
                    cast_to_MatmulShapeTiling()->GetTiling().GetStepM()) % cast_to_MLoop()->GetTotalIter(), 0,
                    cast_to_MLoop()->GetTileShapeOf(cast_to_MLoop()->GetOuterIdx() + 1),
                    cast_to_KLoop()->GetTileShapeA());
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_N) {
                if ((cacheB1Factor_ == 1) && (cast_to_MLoop()->GetInnerIdx() %
                    cast_to_MatmulShapeTiling()->GetTiling().GetStepM() == 0) &&
                    (cast_to_NLoop()->GetInnerIdx() + cast_to_MatmulShapeTiling()->GetTiling().GetStepN() <
                    cast_to_NLoop()->GetTotalIter())) {
                    cast_to_CopyCubeInB()->AsyncLoadData(0,
                    (cast_to_NLoop()->GetInnerIdx() + cast_to_MatmulShapeTiling()->GetTiling().GetStepN()) %
                    cast_to_NLoop()->GetTotalIter(), cast_to_KLoop()->GetTileShapeB(),
                    cast_to_NLoop()->GetTileShapeOf(cast_to_NLoop()->GetOuterIdx() + 1));
                }
            }
        }

        if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_K) {
            auto kLoop = cast_to_KLoop();
            const auto& tiling = cast_to_MatmulShapeTiling()->GetTiling();
            if (cacheB1Factor_ == 1 && !cast_to_KLoop()->IsBKL1FullLoad() &&
                (kLoop->GetInnerStartIdx() < kLoop->GetTotalIter() - tiling.GetStepKb())) {

                int32_t nextKbIdx = kLoop->GetInnerStartIdx() + tiling.GetStepKb();
                cast_to_CopyCubeInB()->AsyncLoadData(nextKbIdx, cast_to_NLoop()->GetInnerIdx(),
                    kLoop->GetTileShapeBOf(nextKbIdx / tiling.GetStepKb()), cast_to_NLoop()->GetTileShape());
            } else if (cacheB1Factor_ == 1 && !cast_to_KLoop()->IsBKL1FullLoad() &&
                (kLoop->GetInnerStartIdx() == kLoop->GetTotalIter() - tiling.GetStepKb())) {

                cast_to_CopyCubeInB()->AsyncLoadData(0,
                    (cast_to_NLoop()->GetInnerIdx() + 1) % cast_to_NLoop()->GetTotalIter(),
                    kLoop->GetTileShapeBOf(1), cast_to_NLoop()->GetTileShape());
            }
        }
    }

    [aicore] inline void DoPreloadAWait()
    {
        if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_M) {
            if ((cacheA1Factor_ == 1) && (cast_to_NLoop()->GetInnerIdx() >=
                cast_to_NLoop()->GetOuterIdx() * cast_to_MatmulShapeTiling()->GetTiling().GetStepN() +
                cast_to_NLoop()->GetInnerIter() - 1) && (cast_to_MLoop()->GetInnerIdx() +
                cast_to_MatmulShapeTiling()->GetTiling().GetStepM() < cast_to_MLoop()->GetTotalIter())) {
                cast_to_CopyCubeInA()->AwaitLoadData();
            }
        } else if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_N) {
            if ((cacheB1Factor_ == 1) && (cast_to_MLoop()->IsLastInnerIter()) &&
                (cast_to_NLoop()->GetInnerIdx() + cast_to_MatmulShapeTiling()->GetTiling().GetStepN() <
                cast_to_NLoop()->GetTotalIter())) {
                cast_to_CopyCubeInB()->AwaitLoadData();
            }
        } else if constexpr (ToMatmulConfig(MM_CFG).doMTE2Preload == PRELOAD_K) {
            if (cacheB1Factor_ == 1 && !cast_to_KLoop()->IsBKL1FullLoad()) {
                cast_to_CopyCubeInB()->AwaitLoadData();
            }
        }
    }

protected:
    bool isFirstIter_ = true;
    constexpr static int32_t c0Size_ = AuxGetC0Size<typename A_TYPE::T>();
    int32_t cacheA1Factor_, cacheB1Factor_;
};

}
