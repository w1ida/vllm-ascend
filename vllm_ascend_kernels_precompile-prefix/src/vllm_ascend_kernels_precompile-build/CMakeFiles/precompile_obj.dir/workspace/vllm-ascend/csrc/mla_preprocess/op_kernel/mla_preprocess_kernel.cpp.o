namespace Impl {
namespace Detail {
struct DfxFuncInfo {
    [aicore] inline DfxFuncInfo(__attribute__((cce_global)) const char* module, __attribute__((cce_global)) const char* func, uint32_t funcId)
    :module(module), func(func), funcId(funcId) {
    }
    __attribute__((cce_global)) const char* module;
    __attribute__((cce_global)) const char* func;
