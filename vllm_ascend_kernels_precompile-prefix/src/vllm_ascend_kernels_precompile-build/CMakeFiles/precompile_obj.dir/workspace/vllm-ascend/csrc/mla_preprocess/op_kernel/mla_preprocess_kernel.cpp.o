        s4GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) int32_t *>(s4Gm));
        qGmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) Q_OUT_DTYPE *>(qGm));
        qGmTensor2.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(qGm2));
