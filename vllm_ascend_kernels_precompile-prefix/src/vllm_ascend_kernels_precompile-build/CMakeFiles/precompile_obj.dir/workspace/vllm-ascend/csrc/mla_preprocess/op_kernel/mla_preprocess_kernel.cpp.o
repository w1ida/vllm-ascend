                nLoop->GetBaseShape(), mLoop->GetBaseBlockShape(), nLoop->GetBaseBlockShape(), enAtomic, enSequentialWrite);
            int32_t baseUseN = (nLoop->GetOuterIdx() + 2 == nLoop->GetTotalIter()) ? nLoop->GetTail() : tiling.GetBaseN();
