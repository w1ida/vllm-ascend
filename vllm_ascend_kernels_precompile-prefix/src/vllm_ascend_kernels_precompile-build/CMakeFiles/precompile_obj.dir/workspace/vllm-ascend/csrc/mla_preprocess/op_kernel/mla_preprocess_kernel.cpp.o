    {
    }

    template <class T> [aicore] inline void SetWorkspace(GlobalTensor<T>& addr)
    {
                                  ;
        SetWorkspace(addr.GetPhyAddr(), addr.GetSize() * sizeof(T));
    }

    [aicore] inline void SetLocalWorkspace(const LocalTensor<uint8_t>& tmpBuffer)
    {
        cast_to_LocalWorkspace()->Init(tmpBuffer);
    }

