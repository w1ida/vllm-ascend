    [aicore] inline constexpr decltype(auto) cast_to_KLoop() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::KLoop> (*(static_cast<typename IMPL::KLoop*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::KLoop*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_KLoop() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::KLoop> (*(static_cast<const typename IMPL::KLoop*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::KLoop*>(static_cast<const IMPL*>(this))); } };
    using TransT = typename INPUT_TYPE::TRANS_T;
    using SrcT = typename INPUT_TYPE::T;

public:
    using BASE_MODULE = AscendC::Impl::Detail::CopyCubeInBase<IMPL, MM_CFG, INPUT_TYPE>;
    [aicore] inline CopyCubeIn() = default;
    [aicore] inline ~CopyCubeIn() = default;

    [aicore] inline void SetInput(const GlobalTensor<SrcT>& globalMatrix, bool isTranspose)
    {
        if constexpr (ToMatmulConfig(MM_CFG).intraBlockPartSum) {
            if (cast_to_MatmulSubBlockInfo()->GetSubBlockIdx() == 0) {
                cast_to_MatmulTensorInfo()->template SetGlobalTensor<false>(globalMatrix, isTranspose);
            } else {
                cast_to_MatmulTensorInfo()->template SetGlobalTensor<true>(globalMatrix, isTranspose);
            }
        } else {
            cast_to_MatmulTensorInfo()->template SetGlobalTensor<false>(globalMatrix, isTranspose);
        }
        cast_to_CubeInBuffer()->Reset();
        if constexpr (IsSameABTemplate<INPUT_TYPE, MM_CFG>()) {
            cast_to_CubeInBuffer()->SetOrgTensor(cast_to_MatmulTensorInfo()->GetGlobalTensor());
        }
    }

    [aicore] inline void SetInput(const LocalTensor<SrcT>& localMatrix, bool isTranspose)
    {
        BASE_MODULE::SetInput(localMatrix, isTranspose);
    }

    template <typename ScheduleContext = int>
    [aicore] inline LocalTensor<TransT> LoadData(
        int32_t curRow, int32_t curCol, int32_t tileHeight, int32_t tileWidth, const ScheduleContext& context = {})
    {
        LocalTensor<TransT> l1;
        auto posL1 = GetIterIndex(curRow, curCol);
        if (cast_to_CubeInBuffer()->Hit(posL1)) {
            l1 = cast_to_CubeInBuffer()->GetBuffer(posL1);
        } else {
            l1 = cast_to_CubeInBuffer()->AllocTensor(posL1);
            if constexpr (ToMatmulConfig(MM_CFG).intraBlockPartSum) {
                if (cast_to_MatmulSubBlockInfo()->IsFakeIntraBlock()) {
                    cast_to_DataCopyUtils()->template CopyTileToCube<false>(
                        l1, curRow, curCol, tileHeight, tileWidth);
                } else {
                    cast_to_DataCopyUtils()->template CopyTileToCube<true>(
                        l1, curRow, curCol, tileHeight, tileWidth);
                }
            } else {
                cast_to_DataCopyUtils()->template CopyTileToCube<false>(
                    l1, curRow, curCol, tileHeight, tileWidth);
            }
            cast_to_CubeInBuffer()->EnQue(l1);
            cast_to_CubeInBuffer()->DeQue();
        }
        return l1;
    }

    template <typename ScheduleContext = int>
    [aicore] inline LocalTensor<TransT> AsyncLoadData(
        int32_t curRow, int32_t curCol, int32_t tileHeight, int32_t tileWidth, const ScheduleContext& context = {})
    {
        LocalTensor<TransT> l1;
        auto posL1 = GetIterIndex(curRow, curCol);
        if (cast_to_CubeInBuffer()->Hit(posL1)) {
            return cast_to_CubeInBuffer()->GetBuffer(posL1);
        } else {
            l1 = cast_to_CubeInBuffer()->AllocTensor(posL1);
            cast_to_DataCopyUtils()->CopyTileToCube(l1, curRow, curCol, tileHeight, tileWidth);
            cast_to_CubeInBuffer()->EnQue(l1);
            return l1;
        }
    }

    [aicore] inline void AwaitLoadData()
    {
        cast_to_CubeInBuffer()->DeQue();
    }

    [aicore] inline void ClearLoadData(const LocalTensor<TransT>& tensor = LocalTensor<TransT>{},
        int32_t curRow = 0, int32_t curCol = 0)
    {
        auto posL1 = GetIterIndex(curRow, curCol);
        cast_to_CubeInBuffer()->FreeTensor(posL1, tensor);
    }

private:
    [aicore] constexpr int32_t GetIterIndex(int32_t curRow, int32_t curCol)
    {
        if constexpr (GetCubeInBufferType<INPUT_TYPE, MM_CFG>() == CubeInBufferType::SINGLE_BUFFER) {
            return 0;
        } else if constexpr (GetCubeInBufferType<INPUT_TYPE, MM_CFG>() == CubeInBufferType::NORMAL ||
                             GetCubeInBufferType<INPUT_TYPE, MM_CFG>() == CubeInBufferType::SINGLE_GLOBAL_BUFFER ||
                             GetCubeInBufferType<INPUT_TYPE, MM_CFG>() == CubeInBufferType::DOUBLE_GLOBAL_BUFFER) {
            return GetIterIndexInner(curRow, curCol);
        }
    }

    template <typename INPUT_TYPE_ALIAS = INPUT_TYPE>
    [aicore] constexpr enable_if_t<INPUT_TYPE_ALIAS::TAG == InputTypeTag::A, int32_t>
    GetIterIndexInner(int32_t curRow, int32_t curCol)
    {
        if constexpr (DoMatmulNorm(MM_CFG) || DoMatmulIBShareNorm(MM_CFG) || DoMatmulBasicBlock(MM_CFG)) {
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                if (cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() ==
                    static_cast<int>(IterateOrder::ORDER_M)) {
                    return curCol;
                } else {
                    if constexpr (INPUT_TYPE::layout == LayoutMode::NONE &&
                        ToMatmulConfig(MM_CFG).scheduleType == ScheduleType::OUTER_PRODUCT) {
                        return (curRow + (curRow / DOUBLE_QUE) * DOUBLE_QUE *
                            (cast_to_KLoop()->GetTotalIter() - 1) + curCol * DOUBLE_QUE) %
                            (cast_to_MatmulShapeTiling()->GetTiling().GetStepM() * cast_to_KLoop()->GetTotalIter());
                    }
                    return (curRow * cast_to_KLoop()->GetTotalIter() + curCol) %
                        (cast_to_MatmulShapeTiling()->GetTiling().GetStepM() * cast_to_KLoop()->GetTotalIter());
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                return curCol;
            } else {
                if constexpr (INPUT_TYPE::layout == LayoutMode::NONE &&
                    ToMatmulConfig(MM_CFG).scheduleType == ScheduleType::OUTER_PRODUCT) {
                    return (curRow + (curRow / DOUBLE_QUE) * DOUBLE_QUE *
                        (cast_to_KLoop()->GetTotalIter() - 1) + curCol * DOUBLE_QUE) %
                        (cast_to_MatmulShapeTiling()->GetTiling().GetStepM() * cast_to_KLoop()->GetTotalIter());
                }
                return (curRow * cast_to_KLoop()->GetTotalIter() + curCol) %
                    (cast_to_MatmulShapeTiling()->GetTiling().GetStepM() * cast_to_KLoop()->GetTotalIter());
            }
        } else if constexpr (DoMatmulSpecialBasicBlock(MM_CFG)) {
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                if (cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() ==
                    static_cast<int>(IterateOrder::ORDER_M)) {
                    return curCol;
                } else {
                    return (curRow * cast_to_KLoop()->GetTotalIter() + curCol) %
                        (ToMatmulConfig(MM_CFG).stepM * ToMatmulConfig(MM_CFG).singleCoreK /
                            ToMatmulConfig(MM_CFG).basicK);
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                return curCol;
            } else {
                return (curRow * cast_to_KLoop()->GetTotalIter() + curCol) %
                    (ToMatmulConfig(MM_CFG).stepM * ToMatmulConfig(MM_CFG).singleCoreK /
                        ToMatmulConfig(MM_CFG).basicK);
            }
        } else {
            return 0;
        }
    }

    template <typename INPUT_TYPE_ALIAS = INPUT_TYPE>
    [aicore] constexpr enable_if_t<INPUT_TYPE_ALIAS::TAG == InputTypeTag::B, int32_t>
    GetIterIndexInner(int32_t curRow, int32_t curCol)
    {
        if constexpr (DoMatmulNorm(MM_CFG) || DoMatmulIBShareNorm(MM_CFG) || DoMatmulBasicBlock(MM_CFG)) {
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                return GetNormIterBIdxForUndef(curRow, curCol);
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                if constexpr (INPUT_TYPE::layout == LayoutMode::NONE &&
                    ToMatmulConfig(MM_CFG).scheduleType == ScheduleType::OUTER_PRODUCT) {
                    return (curCol + (curCol / DOUBLE_QUE) * DOUBLE_QUE *
                        (cast_to_KLoop()->GetTotalIter() - 1) + curRow * DOUBLE_QUE) %
                        (cast_to_MatmulShapeTiling()->GetTiling().GetStepN() * cast_to_KLoop()->GetTotalIter());
                }
                return (curRow + curCol * cast_to_KLoop()->GetTotalIter()) %
                    (cast_to_MatmulShapeTiling()->GetTiling().GetStepN() * cast_to_KLoop()->GetTotalIter());
            } else {
                return curRow;
            }
        } else if (DoMatmulSpecialBasicBlock(MM_CFG)) {
            if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::UNDEF) {
                if (cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() ==
                    static_cast<int>(IterateOrder::ORDER_M)) {
                    return (curRow + curCol * cast_to_KLoop()->GetTotalIter()) % ToMatmulConfig(MM_CFG).stepN *
                        ToMatmulConfig(MM_CFG).singleCoreK / ToMatmulConfig(MM_CFG).basicK;
                } else {
                    return curRow;
                }
            } else if constexpr (ToMatmulConfig(MM_CFG).iterateOrder == IterateOrder::ORDER_M) {
                return (curRow + curCol * cast_to_KLoop()->GetTotalIter()) % ToMatmulConfig(MM_CFG).stepN *
                    ToMatmulConfig(MM_CFG).singleCoreK / ToMatmulConfig(MM_CFG).basicK;
            } else {
                return curRow;
            }
        } else {
            return 0;
        }
    }

    [aicore] int32_t GetNormIterBIdxForUndef(int32_t curRow, int32_t curCol)
    {
        if (cast_to_MatmulShapeTiling()->GetTiling().GetIterateOrder() ==
            static_cast<int>(IterateOrder::ORDER_M)) {
            if constexpr (INPUT_TYPE::layout == LayoutMode::NONE &&
                ToMatmulConfig(MM_CFG).scheduleType == ScheduleType::OUTER_PRODUCT) {
                return (curCol + (curCol / DOUBLE_QUE) * DOUBLE_QUE *
                    (cast_to_KLoop()->GetTotalIter() - 1) + curRow * DOUBLE_QUE) %
                    (cast_to_MatmulShapeTiling()->GetTiling().GetStepN() * cast_to_KLoop()->GetTotalIter());
            }
            return (curRow + curCol * cast_to_KLoop()->GetTotalIter()) %
                (cast_to_MatmulShapeTiling()->GetTiling().GetStepN() * cast_to_KLoop()->GetTotalIter());
        } else {
            if constexpr (DoMatmulIBShareNorm(MM_CFG) && MatmulFeatureTrait<MM_CFG>::IsSupportLoad2dV2()) {
                return (curRow + curCol * cast_to_KLoop()->GetTotalIter()) %
                    (cast_to_MatmulShapeTiling()->GetTiling().GetStepN() * cast_to_KLoop()->GetTotalIter());
            }
            return curRow;
        }
    }
};
}
}
