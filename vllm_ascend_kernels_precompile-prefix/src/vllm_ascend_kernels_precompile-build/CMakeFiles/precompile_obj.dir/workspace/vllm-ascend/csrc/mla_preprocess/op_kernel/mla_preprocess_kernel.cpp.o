        offset1 = i * tiling.splitSize;
        PipeBarrier<PIPE_V>();
        ReduceMaxLastNDImpl(tmpBuffer4, src[offset1], reduceSumBuffer, reduceMainParam);
        PipeBarrier<PIPE_V>();
        BroadCastLastImpl(tmpBuffer1, tmpBuffer4, mainBrcParam);
