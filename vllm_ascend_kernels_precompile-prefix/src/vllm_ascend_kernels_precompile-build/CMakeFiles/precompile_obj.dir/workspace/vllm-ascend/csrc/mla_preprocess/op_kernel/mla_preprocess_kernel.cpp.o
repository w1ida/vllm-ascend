namespace AscendC {
namespace Impl {
namespace Detail {





template <typename IMPL, typename A_TYPE, typename B_TYPE, const auto& MM_CFG>
class TBufPoolL0Base
{
    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this))); } };
public:
    [aicore] inline TBufPoolL0Base() = default;
    [aicore] inline ~TBufPoolL0Base() = default;
    [aicore] inline void Init()
    {
        bool isL0Db;
        if constexpr (NormInitScene<MM_CFG> && Impl::Detail::MatmulFeatureTrait<MM_CFG>().IsSupportMNL0DB()) {
            isL0Db = true;
        } else if constexpr (IsBasic(MM_CFG) && NormInitScene<MM_CFG> &&
            Impl::Detail::MatmulFeatureTrait<MM_CFG>().IsSupportLoad2dV2()) {
            isL0Db = false;
        } else {
            const auto& tiling = cast_to_MatmulShapeTiling()->GetTiling();
            isL0Db = (tiling.GetDbL0A() - 1) & (tiling.GetDbL0B() - 1);
        }

        useL0PingPong_ = static_cast<uint16_t>(isL0Db);
        GetTPipePtr()->InitBuffer(l0aBuf_, 65536);
        GetTPipePtr()->InitBuffer(l0bBuf_, 65536);
    }

    [aicore] inline void SetDBFlag(bool isL0Db = true)
    {
        useL0PingPong_ = static_cast<uint16_t>(isL0Db);
    }

    template <bool IS_INTRA_BLOCK = false>
    [aicore] inline TBufPoolL0Base& Allocate() {
        if constexpr (!IS_INTRA_BLOCK) {
            WaitFlag<HardEvent::M_MTE1>(l0PingPongFlag_);
        }
        return *this;
    }

    template <TPosition Pos, typename T, bool IS_INTRA_BLOCK = false>
    [aicore] inline LocalTensor<T> GetBuffer(uint8_t subIdx = 0)
    {
        LocalTensor<T> tempTensor;
        if constexpr (Pos == TPosition::A2) {
            tempTensor = l0aBuf_.Get<T>();
            if (l0PingPongFlag_ != 0) {
                if constexpr (IsSupportB4<T>()) {
                    tempTensor = tempTensor[65536 / sizeof(T)];
                } else {
                    tempTensor = tempTensor[65536 / 2 / sizeof(T)];
                }
            }
        } else {
            tempTensor = l0bBuf_.Get<T>();
            if constexpr (IS_INTRA_BLOCK) {
                if (subIdx != 0) {
                    tempTensor = tempTensor[65536 / 2 / sizeof(T)];
                }
            } else {
                if (l0PingPongFlag_ != 0) {
                    if constexpr (IsSupportB4<T>()) {
                        tempTensor = tempTensor[65536 / sizeof(T)];
                    } else {
                        tempTensor = tempTensor[65536 / 2 / sizeof(T)];
                    }
                }
            }
        }
        return tempTensor;
    }

    template <TPosition Pos>
    [aicore] inline bool Hit(uint32_t pos = 0) {
        return false;
    }

    [aicore] inline void ResetCache() {}

    [aicore] inline void EnQue()
    {
        SetFlag<HardEvent::MTE1_M>(l0PingPongFlag_);
    }

    [aicore] inline void DeQue()
    {
        WaitFlag<HardEvent::MTE1_M>(l0PingPongFlag_);
    }

    [aicore] inline void Free()
    {
        SetFlag<HardEvent::M_MTE1>(l0PingPongFlag_);
        l0PingPongFlag_ = useL0PingPong_ - l0PingPongFlag_;
    }

protected:
    TBuf<TPosition::A2> l0aBuf_;
    TBuf<TPosition::B2> l0bBuf_;
    uint16_t l0PingPongFlag_{0};
    uint16_t useL0PingPong_{1};
};

}
}
