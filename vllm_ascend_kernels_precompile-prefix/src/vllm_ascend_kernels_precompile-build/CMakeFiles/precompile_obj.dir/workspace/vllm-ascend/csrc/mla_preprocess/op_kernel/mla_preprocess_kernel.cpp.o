template <typename IMPL, class INPUT_TYPE, const auto& MM_CFG, PolicyType POLICY_TYPE>
class CubeInBuffer<IMPL, INPUT_TYPE, MM_CFG, POLICY_TYPE, enable_if_t<
GetCubeInBufferType<INPUT_TYPE, MM_CFG>() == CubeInBufferType::DOUBLE_BUFFER_SPARSE>> {
    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeTiling*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeTiling() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeTiling> (*(static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeTiling*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::MatmulShapeInfo*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulShapeInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::MatmulShapeInfo> (*(static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::MatmulShapeInfo*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_Context() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::Context> (*(static_cast<typename IMPL::Context*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::Context*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_Context() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::Context> (*(static_cast<const typename IMPL::Context*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::Context*>(static_cast<const IMPL*>(this))); } };
    [aicore] inline constexpr decltype(auto) cast_to_MatmulTensorInfo() { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<IMPL, typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG> > (*(static_cast<typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this)))); } else { return (static_cast<typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<IMPL*>(this))); } } [aicore] inline constexpr decltype(auto) cast_to_MatmulTensorInfo() const { if constexpr (AscendC::Impl::Detail::DfxConfig::ENABLE) { return typename AscendC::Impl::Detail::DfxProxy<const IMPL, typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG> > (*(static_cast<const typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this)))); } else { return (static_cast<const typename IMPL::template MatmulTensorInfo<INPUT_TYPE::TAG>*>(static_cast<const IMPL*>(this))); } };
    using TransT = typename INPUT_TYPE::TRANS_T;
public:
    [aicore] inline CubeInBuffer() {}
    [aicore] inline ~CubeInBuffer() {}
    [aicore] inline void Init(int32_t baseBlockSize, int32_t cacheNum)
    {
        int32_t matrixByteSize = baseBlockSize * AscendC::GetBitSize<TransT>() / ONE_BYTE_BIT_SIZE;
        int32_t stepSize = GetTotalCacheNum();

                                                                                 ;
        cacheFactor_ = (cacheNum / stepSize - 1) & 1;
        int32_t queDepth = cacheFactor_ == 0 ? SINGLE_QUE : DOUBLE_QUE;
        GetTPipePtr()->InitBuffer(qid_, queDepth, ((matrixByteSize * stepSize) >> 1));
        GetTPipePtr()->InitBuffer(idxQid_, queDepth, ((matrixByteSize * stepSize) >> 3));
    }

    [aicore] inline void Destroy()
    {
        isCachingPing_ = false;
        isCachingPong_ = false;
        qid_.FreeAllEvent();
        idxQid_.FreeAllEvent();
    }

    [aicore] inline LocalTensor<TransT> AllocTensor(int32_t bufferPos = -1)
    {

                                                                                                            ;
        LocalTensor<TransT> tensor = qid_.template AllocTensor<TransT>();
        LocalTensor<uint8_t> idxTensor = idxQid_.template AllocTensor<uint8_t>();
        int32_t cachePos = bufferPos & cacheFactor_;
        SetCache(cachePos, tensor, idxTensor);
        SetBufferCaching(cachePos, true);
        cast_to_MatmulTensorInfo()->SetLocalSparseIndex(idxTensor);
        return tensor;
    }

    [aicore] inline void FreeTensor(int32_t bufferPos = -1, const LocalTensor<TransT>& tensor = LocalTensor<TransT>{})
    {

                                                                                ;
        int32_t cachePos = bufferPos & cacheFactor_;
        if (IsBufferCaching(cachePos)) {
            qid_.FreeBuffer(GetCache(cachePos));
            idxQid_.FreeBuffer(GetIdxCache(cachePos));
            SetBufferCaching(cachePos, false);
        }
    }

    [aicore] inline void Reset()
    {
        if (IsBufferCaching(0)) {
            qid_.FreeBuffer(GetCache(0));
            idxQid_.FreeBuffer(GetIdxCache(0));
            SetBufferCaching(0, false);
        }
        if (IsBufferCaching(1)) {
            qid_.FreeBuffer(GetCache(1));
            idxQid_.FreeBuffer(GetIdxCache(1));
            SetBufferCaching(1, false);
        }
    }

    [aicore] inline bool Hit(int32_t iterIndex, int32_t bufferPos = -1)
    {

                                                                         ;
        return iterIndex != 0 || IsBufferCaching(bufferPos & cacheFactor_);
    }

    [aicore] inline LocalTensor<TransT> GetBuffer(int32_t iterIndex, int32_t bufferPos = -1)
    {
        (void) iterIndex;

                                                                         ;
        LocalTensor<TransT> tensor;
        tensor.SetAddr(qid_.GetBufferAddr(GetCache(bufferPos & cacheFactor_)));

        LocalTensor<uint8_t> idxTensor;
        idxTensor.SetAddr(idxQid_.GetBufferAddr(GetIdxCache(bufferPos & cacheFactor_)));
        cast_to_MatmulTensorInfo()->SetLocalSparseIndex(idxTensor);
        return tensor;
    }

    [aicore] inline void EnQue(LocalTensor<TransT>& tensor)
    {
        qid_.EnQue(tensor);
        auto idxTensor = cast_to_MatmulTensorInfo()->GetLocalSparseIndex();
        idxQid_.EnQue(idxTensor);
    }

    [aicore] inline void DeQue()
    {
        (void) qid_.DeQue();
        (void) idxQid_.DeQue();
    }

private:
    [aicore] inline int32_t GetTotalCacheNum()
    {
        if constexpr (INPUT_TYPE::TAG == InputTypeTag::B) {
            return cast_to_MatmulShapeTiling()->GetTiling().GetStepKb() *
                cast_to_MatmulShapeTiling()->GetTiling().GetStepN();
        } else {
            return cast_to_MatmulShapeTiling()->GetTiling().GetStepKa() *
                cast_to_MatmulShapeTiling()->GetTiling().GetStepM();
        }
    }

    [aicore] inline int32_t GetMajorCacheNum()
    {
        if constexpr (INPUT_TYPE::TAG == InputTypeTag::B) {
            return cast_to_MatmulShapeTiling()->GetTiling().GetStepKb();
        } else {
            return cast_to_MatmulShapeTiling()->GetTiling().GetStepKa();
        }
    }

    [aicore] inline auto& GetCache(bool isPong)
    {
        return isPong ? cachePong_ : cachePing_;
    }

    [aicore] inline auto& GetIdxCache(bool isPong)
    {
        return isPong ? idxCachePong_ : idxCachePing_;
    }

    [aicore] inline void SetBufferCaching(bool isPong, bool isCaching)
    {
        if (isPong) {
            isCachingPong_ = isCaching;
        } else {
            isCachingPing_ = isCaching;
        }
    }

    [aicore] inline bool IsBufferCaching(bool isPong)
    {
        return isPong ? isCachingPong_ : isCachingPing_;
    }

    [aicore] inline void SetCache(bool isPong, const LocalTensor<TransT>& cacheTensor, const LocalTensor<uint8_t>& idxCacheTensor)
    {
        if (isPong) {
            cachePong_ = cacheTensor.GetBufferHandle();
            idxCachePong_ = idxCacheTensor.GetBufferHandle();
        } else {
            cachePing_ = cacheTensor.GetBufferHandle();
            idxCachePing_ = idxCacheTensor.GetBufferHandle();
        }
    }

private:
    TBufHandle cachePing_;
    typename CubeInQueType<INPUT_TYPE>::QUE qid_;
    TBufHandle cachePong_;
    typename CubeInQueType<INPUT_TYPE>::QUE idxQid_;
    TBufHandle idxCachePing_;
    int32_t cacheFactor_;
    TBufHandle idxCachePong_;
    bool isCachingPing_ { false };
    bool isCachingPong_ { false };
};

}
}
