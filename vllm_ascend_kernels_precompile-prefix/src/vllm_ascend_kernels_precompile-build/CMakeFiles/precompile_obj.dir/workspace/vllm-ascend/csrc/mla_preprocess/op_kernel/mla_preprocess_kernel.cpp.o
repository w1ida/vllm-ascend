        gamma3GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(gamma3Gm));
        sin1GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(sin1Gm));
