    }

private:
    [aicore] inline bool IsTailBlock()
    {
        if constexpr (INPUT_TYPE::TAG == InputTypeTag::A) {
            return (cast_to_MLoop()->GetBaseShape() != cast_to_MatmulShapeTiling()->GetTiling().GetBaseM()) ||
                   (cast_to_KLoop()->GetBaseShape() != cast_to_MatmulShapeTiling()->GetTiling().GetBaseK());
        } else {
            return (cast_to_NLoop()->GetBaseShape() != cast_to_MatmulShapeTiling()->GetTiling().GetBaseN()) ||
                   (cast_to_KLoop()->GetBaseShape() != cast_to_MatmulShapeTiling()->GetTiling().GetBaseK());
        }
    }

    [aicore] inline bool IsDataAmountEqual()
    {
        if constexpr (INPUT_TYPE::TAG == InputTypeTag::A) {
            return (cast_to_MLoop()->GetBaseShape() == cast_to_MatmulShapeTiling()->GetTiling().GetBaseM()) &&
                   (cast_to_KLoop()->GetBaseShape() == cast_to_MatmulShapeTiling()->GetTiling().GetBaseK());
        } else {
            return (cast_to_KLoop()->GetBaseShape() == cast_to_MatmulShapeTiling()->GetTiling().GetBaseK()) &&
                   (cast_to_NLoop()->GetBaseShape() == cast_to_MatmulShapeTiling()->GetTiling().GetBaseN());
