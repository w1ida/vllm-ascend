                TCubeTiling cubeTiling;
                CopyTiling<A_TYPE, B_TYPE, MM_CFG>(tiling, cubeTiling);
                tiling_.SetTiling(&cubeTiling);
                mul.Init(tiling_.GetTiling(), nullptr);
            } else {

                tiling_.SetTiling((TCubeTiling *)tiling);
                mul.Init(tiling_.GetTiling(), nullptr);

            }




        } else if (tiling) {
            tiling_.SetTiling((TCubeTiling *)tiling);
            mul.Init(tiling_.GetTiling(), nullptr);



        }
