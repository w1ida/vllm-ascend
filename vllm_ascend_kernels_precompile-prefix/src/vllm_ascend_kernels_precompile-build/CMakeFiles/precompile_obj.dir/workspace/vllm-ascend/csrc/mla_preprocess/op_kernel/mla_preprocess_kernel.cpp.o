[aicore] inline __attribute__((in_pipe("V")))
    __attribute__((out_pipe("MTE3"))) void Fill(GlobalTensor<T> &gmWorkspaceAddr, const uint64_t size, const T value)
{
    InitGlobalMemoryImpl<T>(gmWorkspaceAddr, size, value);
