        return outerIndex_;
    }

    [aicore] inline uint32_t GetOuterIter() const
    {
        return outerIter_;
    }

    [aicore] inline int32_t GetTileShape() const
    {
        return tileShape_;
    }

    [aicore] inline int32_t GetTileShapeOf(int32_t outerIdx) const
