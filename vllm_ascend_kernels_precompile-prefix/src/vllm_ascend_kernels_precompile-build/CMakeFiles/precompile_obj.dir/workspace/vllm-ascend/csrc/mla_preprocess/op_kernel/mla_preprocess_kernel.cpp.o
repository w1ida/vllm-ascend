        s3GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) InDtype *>(s3Gm));
        s5GmTensor.SetGlobalBuffer(reinterpret_cast<__attribute__((cce_global)) float *>(s5Gm));
